'use client'

import { useEffect, useMemo, useState } from 'react'
import { useFpStore } from '@/store/feedbackpro-store'
import {
  type Retour,
  type Recommandation,
  type StatutRetour,
  type Gravite,
  type Urgence,
  URGENCES,
  urgenceForRetour,
  graviteForTag,
  graviteEmoji,
  getTagInfo,
  getZoneEmoji,
  ACTION_TAGS,
  RECOMPENSE_DUREE_VALIDITE_H,
  dateExpirationRecompense,
} from '@/lib/feedbackpro/types'
import { Button } from '@/components/ui/button'
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card'
import { Badge } from '@/components/ui/badge'
import { Textarea } from '@/components/ui/textarea'
import { Label } from '@/components/ui/label'
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from '@/components/ui/select'
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogFooter,
  DialogHeader,
  DialogTitle,
  DialogTrigger,
} from '@/components/ui/dialog'
import {
  AlertDialog,
  AlertDialogAction,
  AlertDialogCancel,
  AlertDialogContent,
  AlertDialogDescription,
  AlertDialogFooter,
  AlertDialogHeader,
  AlertDialogTitle,
} from '@/components/ui/alert-dialog'
import { Star, ArrowLeft, Trash2, MessageCircle, Send, CheckCircle2, Sparkles, Brain, Gift, PenLine, Camera, MessageSquareText, Loader2, History, AlertTriangle, Lightbulb, TrendingUp, Phone, Clock, Timer, Hourglass } from 'lucide-react'
import { cn } from '@/lib/utils'
import { toast } from 'sonner'

// =============================================================================
// Helpers de rendu
// =============================================================================

function formatDateFr(d: string | Date): string {
  const date = typeof d === 'string' ? new Date(d) : d
  return date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })
}

function formatDateTimeFr(d: string | Date): string {
  const date = typeof d === 'string' ? new Date(d) : d
  return date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }) + ' à ' + date.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })
}

function StarsRow({ nps, size = 'sm' }: { nps: number; size?: 'sm' | 'md' }) {
  const sz = size === 'sm' ? 'w-4 h-4' : 'w-5 h-5'
  return (
    <span className="inline-flex items-center gap-0.5" aria-label={`${nps} sur 5`}>
      {[1, 2, 3, 4, 5].map((i) => (
        <Star
          key={i}
          className={cn(sz, i <= nps ? 'fill-current text-amber-400' : 'text-muted-foreground/40')}
        />
      ))}
    </span>
  )
}

function StatutBadge({ statut }: { statut: StatutRetour }) {
  const map: Record<StatutRetour, { label: string; cls: string }> = {
    NOUVEAU: { label: 'Nouveau', cls: 'bg-blue-100 text-blue-700 dark:bg-blue-950 dark:text-blue-300' },
    EN_COURS: { label: 'En cours', cls: 'bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300' },
    RESOLU: { label: 'Résolu', cls: 'bg-green-100 text-green-700 dark:bg-green-950 dark:text-green-300' },
  }
  const m = map[statut]
  return <span className={cn('inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium', m.cls)}>{m.label}</span>
}

function GraviteBadge({ gravite }: { gravite: Gravite }) {
  const map: Record<Gravite, string> = {
    CRITIQUE: 'bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300',
    'ÉLEVÉE': 'bg-orange-100 text-orange-700 dark:bg-orange-950 dark:text-orange-300',
    MOYENNE: 'bg-yellow-100 text-yellow-700 dark:bg-yellow-950 dark:text-yellow-300',
    OK: 'bg-green-100 text-green-700 dark:bg-green-950 dark:text-green-300',
  }
  return (
    <span className={cn('inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium', map[gravite])}>
      <span>{graviteEmoji(gravite)}</span>
      {gravite}
    </span>
  )
}

// =============================================================================
// Onglet principal
// =============================================================================

export function RetoursTab() {
  const { detailRetourId, retours } = useFpStore()

  // Early-return : si un détail est sélectionné → on rend la page détail
  if (detailRetourId) {
    const r = retours.find((x) => x.id === detailRetourId)
    if (r) return <RetourDetail retour={r} />
    // Si l'id n'existe pas (encore) dans la liste → on rend quand même le détail via fetch standalone
    return <RetourDetail key={detailRetourId} retour={null} retourId={detailRetourId} />
  }

  return <RetoursList />
}

// =============================================================================
// Liste des retours (vue par défaut)
// =============================================================================

function RetoursList() {
  const { retours, retoursLoading, openDetail, fetchRetours } = useFpStore()
  const [filter, setFilter] = useState<'TOUS' | Urgence>('TOUS')

  useEffect(() => {
    if (retours.length === 0 && !retoursLoading) fetchRetours()
  }, [retours.length, retoursLoading, fetchRetours])

  const filtered = useMemo(() => {
    if (filter === 'TOUS') return retours
    return retours.filter((r) => urgenceForRetour(r.nps, r.isRecidive) === filter)
  }, [retours, filter])

  if (retoursLoading && retours.length === 0) {
    return (
      <div className="flex items-center justify-center py-20">
        <Loader2 className="w-6 h-6 animate-spin text-muted-foreground" />
      </div>
    )
  }

  return (
    <div className="space-y-5">
      <div className="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h1 className="text-2xl font-bold tracking-tight">Retours clients</h1>
          <p className="text-sm text-muted-foreground">{retours.length} retour(s) · cliquez sur une carte pour voir le détail</p>
        </div>
        <div className="flex flex-wrap gap-1">
          {(['TOUS', 'URGENT', 'A_TRAITER', 'MITIGE', 'POSITIF'] as const).map((f) => {
            const active = filter === f
            const label = f === 'TOUS' ? 'Tous' : URGENCES[f].label
            const emoji = f === 'TOUS' ? '📋' : URGENCES[f].emoji
            return (
              <button
                key={f}
                onClick={() => setFilter(f)}
                className={cn(
                  'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium border transition-colors',
                  active
                    ? 'bg-primary text-primary-foreground border-primary'
                    : 'bg-card hover:bg-muted border-border'
                )}
              >
                <span>{emoji}</span>
                {label}
              </button>
            )
          })}
        </div>
      </div>

      {filtered.length === 0 ? (
        <Card>
          <CardContent className="p-10 text-center text-muted-foreground">
            Aucun retour dans cette catégorie.
          </CardContent>
        </Card>
      ) : (
        <div className="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {filtered.map((r) => (
            <RetourCard key={r.id} retour={r} onOpen={() => openDetail(r.id)} />
          ))}
        </div>
      )}
    </div>
  )
}

function RetourCard({ retour, onOpen }: { retour: Retour; onOpen: () => void }) {
  const urgence = urgenceForRetour(retour.nps, retour.isRecidive)
  const u = URGENCES[urgence]
  const hasPhoto = Boolean(retour.photoUrl)
  const hasComment = Boolean(retour.commentaire)

  return (
    <button
      onClick={onOpen}
      className="group text-left rounded-2xl border bg-card overflow-hidden shadow-sm hover:shadow-md transition-all hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-ring"
    >
      {/* Bande colorée d'urgence */}
      <div className="px-4 py-3 text-white" style={{ backgroundColor: u.bg }}>
        <div className="flex items-center justify-between gap-2">
          <span className="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide">
            <span>{u.emoji}</span>
            {u.label}
          </span>
          <StarsRow nps={retour.nps} />
        </div>
      </div>
      <div className="p-4 space-y-2">
        <div className="flex items-start justify-between gap-2">
          <div className="text-sm font-medium line-clamp-2 flex-1">
            {retour.commentaire ?? (retour.zone ? `Retour sur ${retour.zone}` : 'Retour client')}
          </div>
        </div>
        <div className="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
          <span className="inline-flex items-center gap-1">
            <span>{getZoneEmoji(retour.zone)}</span>
            {retour.zone ?? 'Zone non précisée'}
          </span>
          <span>·</span>
          <span>{formatDateFr(retour.createdAt)}</span>
        </div>
        <div className="flex flex-wrap items-center gap-1.5 pt-1">
          <StatutBadge statut={retour.statut} />
          {retour.isRecidive && (
            <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300">
              <AlertTriangle className="w-3 h-3" />
              Récidive
            </span>
          )}
          {retour.recompenseAttribuee && !retour.recompenseUtilisee && (
            <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300">
              <Gift className="w-3 h-3" />
              <RecompenseCountdown dateAttribution={retour.createdAt} compact />
            </span>
          )}
          {retour.recompenseAttribuee && retour.recompenseUtilisee && (
            <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700 dark:bg-green-950 dark:text-green-300">
              <Gift className="w-3 h-3" />
              Récompense utilisée
            </span>
          )}
          {hasPhoto && (
            <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-muted">
              <Camera className="w-3 h-3" />
              Photo
            </span>
          )}
          {hasComment && (
            <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-muted">
              <MessageSquareText className="w-3 h-3" />
              Commentaire
            </span>
          )}
        </div>
      </div>
    </button>
  )
}

// =============================================================================
// Page DÉTAIL — 4 sections verticales
// =============================================================================

function RetourDetail({ retour, retourId }: { retour: Retour | null; retourId?: string }) {
  const { closeDetail } = useFpStore()

  // Si retour est null (id orphelin), on tente un fetch standalone
  const [standalone, setStandalone] = useState<Retour | null>(null)
  useEffect(() => {
    if (!retour && retourId) {
      fetch(`/api/retours/${retourId}`, { credentials: 'include' })
        .then((r) => r.json())
        .then((d) => setStandalone(d?.retour ?? null))
        .catch(() => setStandalone(null))
    }
  }, [retour, retourId])

  const r = retour ?? standalone
  if (!r) {
    return (
      <div className="flex flex-col items-center justify-center py-20 gap-3">
        <Loader2 className="w-6 h-6 animate-spin text-muted-foreground" />
        <p className="text-sm text-muted-foreground">Chargement du retour…</p>
        <Button variant="ghost" size="sm" onClick={closeDetail}>
          <ArrowLeft className="w-4 h-4 mr-1" /> Retour à la liste
        </Button>
      </div>
    )
  }

  return <RetourDetailContent key={r.id} retour={r} />
}

function RetourDetailContent({ retour }: { retour: Retour }) {
  const r = retour
  const {
    closeDetail,
    majRetour,
    supprimerRetour,
    recompense,
    fetchRecommandation,
    recommandations,
    recommandationLoadingId,
  } = useFpStore()

  const urgence = urgenceForRetour(r.nps, r.isRecidive)
  const u = URGENCES[urgence]

  // --- SECTION 4 : état local d'action managériale ---
  const [actionTags, setActionTags] = useState<string[]>(r.actionPrise?.tags ?? [])
  const [actionCommentaire, setActionCommentaire] = useState<string>(r.actionPrise?.commentaire ?? '')
  const [actionStatut, setActionStatut] = useState<StatutRetour>(r.statut)
  const [saving, setSaving] = useState(false)

  // --- SECTION 0 : états des actions ---
  const [showReponseDialog, setShowReponseDialog] = useState(false)
  const [reponseText, setReponseText] = useState(r.reponseGerant ?? '')
  const [sendingReponse, setSendingReponse] = useState(false)
  const [showDeleteDialog, setShowDeleteDialog] = useState(false)
  const [showPhotoDialog, setShowPhotoDialog] = useState(false)
  const [showHistoryDialog, setShowHistoryDialog] = useState(false)
  const [resolving, setResolving] = useState(false)

  // --- SECTION 3 : Coach IA ---
  const reco: Recommandation | undefined = recommandations[r.id]
  useEffect(() => {
    if (!reco) fetchRecommandation(r.id)
  }, [r.id, reco, fetchRecommandation])

  // Handlers métier (conservés)
  async function handleEnvoyerReponse() {
    setSendingReponse(true)
    const ok = await majRetour(r.id, { reponseGerant: reponseText })
    setSendingReponse(false)
    if (ok) {
      toast.success('Réponse envoyée au client.')
      setShowReponseDialog(false)
    } else {
      toast.error("Échec de l'envoi de la réponse.")
    }
  }

  async function handleSupprimer() {
    const ok = await supprimerRetour(r.id)
    if (ok) {
      toast.success('Retour supprimé.')
      setShowDeleteDialog(false)
      closeDetail()
    } else {
      toast.error('Échec de la suppression.')
    }
  }

  async function handleMarquerResolu() {
    setResolving(true)
    const ok = await majRetour(r.id, { statut: 'RESOLU' })
    setResolving(false)
    if (ok) toast.success('Retour marqué comme résolu.')
    else toast.error('Échec de la mise à jour.')
  }

  async function handleEnregistrerAction() {
    setSaving(true)
    const ok = await majRetour(r.id, {
      statut: actionStatut,
      actionPrise: { tags: actionTags, commentaire: actionCommentaire },
    })
    setSaving(false)
    if (ok) toast.success('Action managériale enregistrée.')
    else toast.error("Échec de l'enregistrement.")
  }

  // Appliquer les recommandations IA → pré-remplit SECTION 4
  function appliquerRecommandationsIA() {
    if (!reco) return
    // Mapping heuristique des actions IA vers nos tags d'action
    const newTags = new Set<string>(actionTags)
    const txt = reco.actions.join(' ').toLowerCase()
    if (/formation|briefing|équipe/.test(txt)) newTags.add('formation')
    if (/recadrage|entretien/.test(txt)) newTags.add('recadrage')
    if (/processus|check-list|protocole|inspection/.test(txt)) newTags.add('processus')
    if (/compensation|geste|commercial/.test(txt)) newTags.add('compensation')
    if (newTags.size === actionTags.length) newTags.add('processus')
    setActionTags(Array.from(newTags))
    const commentaireSuggere = reco.actions.map((a, i) => `${i + 1}. ${a}`).join('\n')
    setActionCommentaire((prev) => (prev.trim() ? prev + '\n\n' + commentaireSuggere : commentaireSuggere))
    if (reco.niveau === 'CRITIQUE' && actionStatut === 'NOUVEAU') setActionStatut('EN_COURS')
    toast.success('Recommandations appliquées à l’action managériale.')
    // Scroll vers la section 4
    document.getElementById('section-action')?.scrollIntoView({ behavior: 'smooth', block: 'start' })
  }

  function handleWhatsAppEquipe() {
    const wa = recompense?.whatsapp
    if (!wa) {
      toast.error('WhatsApp non configuré.')
      return
    }
    const num = wa.replace(/[^\d+]/g, '').replace(/^\+/, '')
    const msg = `🚨 Alerte FeedbackPro\nRetour ${r.nps}/5 ${u.emoji}\nZone: ${r.zone ?? 'N/A'}\n${r.commentaire ?? ''}`.slice(0, 800)
    window.open(`https://wa.me/${num}?text=${encodeURIComponent(msg)}`, '_blank')
  }

  // Workflow unifié : "aller étape" (navigation rapide dans le statut)
  function allerEtape(s: StatutRetour) {
    setActionStatut(s)
  }

  return (
    <div className="space-y-5 pb-10">
      {/* ============================================================ */}
      {/* SECTION 0 — En-tête résumé contextuel (sticky)              */}
      {/* ============================================================ */}
      <div
        className="sticky top-[7.5rem] z-20 rounded-2xl shadow-lg overflow-hidden text-white"
        style={{ background: `linear-gradient(135deg, ${u.bg} 0%, ${u.bgDark} 100%)` }}
      >
        <div className="p-4 sm:p-5 space-y-3">
          {/* Ligne 1 : retour */}
          <button
            onClick={closeDetail}
            className="inline-flex items-center gap-1.5 text-sm font-medium text-white/90 hover:text-white transition-colors"
          >
            <ArrowLeft className="w-4 h-4" />
            Retour à la liste
          </button>

          {/* Ligne 2 : titre + urgence */}
          <div className="flex flex-wrap items-start justify-between gap-3">
            <div className="space-y-1">
              <div className="flex items-center gap-2 flex-wrap">
                <span className="text-xs font-semibold uppercase tracking-wider bg-white/20 px-2 py-0.5 rounded">
                  {u.emoji} Retour client
                </span>
                {r.isRecidive && (
                  <span className="text-xs font-semibold uppercase tracking-wider bg-black/30 px-2 py-0.5 rounded inline-flex items-center gap-1">
                    <AlertTriangle className="w-3 h-3" />
                    Récidive
                  </span>
                )}
                <span className="text-xs text-white/80">{formatDateTimeFr(r.createdAt)}</span>
              </div>
              <div className="flex items-center gap-3 flex-wrap">
                <div className="flex items-center gap-1.5">
                  <StarsRow nps={r.nps} size="md" />
                  <span className="text-lg font-bold">{r.nps}/5</span>
                </div>
                <span className="text-white/40">•</span>
                <span className="inline-flex items-center gap-1.5 text-sm">
                  <span>Zone:</span>
                  <span className="font-medium">{getZoneEmoji(r.zone)} {r.zone ?? 'Non précisée'}</span>
                </span>
              </div>
              {r.clientEmail && (
                <div className="text-sm text-white/90 inline-flex items-center gap-1.5">
                  <MessageCircle className="w-3.5 h-3.5" />
                  {r.clientEmail}
                </div>
              )}
            </div>
            <StatutBadgeLight statut={r.statut} />
          </div>

          {/* Ligne 3 : actions */}
          <div className="flex flex-wrap gap-2 pt-1">
            <Button
              size="sm"
              variant="secondary"
              onClick={() => { setReponseText(r.reponseGerant ?? ''); setShowReponseDialog(true) }}
            >
              <PenLine className="w-4 h-4 mr-1.5" />
              Répondre
            </Button>
            {recompense?.whatsappActive && (
              <Button size="sm" variant="secondary" onClick={handleWhatsAppEquipe}>
                <Phone className="w-4 h-4 mr-1.5" />
                WhatsApp équipe
              </Button>
            )}
            <Button size="sm" variant="secondary" onClick={() => setShowDeleteDialog(true)}>
              <Trash2 className="w-4 h-4 mr-1.5" />
              Supprimer
            </Button>
            <Button size="sm" variant="secondary" onClick={handleMarquerResolu} disabled={resolving || r.statut === 'RESOLU'}>
              {resolving ? <Loader2 className="w-4 h-4 mr-1.5 animate-spin" /> : <CheckCircle2 className="w-4 h-4 mr-1.5" />}
              {r.statut === 'RESOLU' ? 'Résolu' : 'Marquer résolu'}
            </Button>
            <Button size="sm" variant="ghost" className="text-white hover:bg-white/10" onClick={() => setShowHistoryDialog(true)}>
              <History className="w-4 h-4 mr-1.5" />
              Historique
            </Button>
          </div>
        </div>
      </div>

      {/* ============================================================ */}
      {/* SECTION 1 — Réponses au questionnaire (cards visuelles)      */}
      {/* ============================================================ */}
      <section className="space-y-3">
        <div className="flex items-center gap-2">
          <h2 className="text-lg font-semibold">Réponses au questionnaire</h2>
          <Badge variant="secondary">{r.reponses?.length ?? r.tags.length} dimension(s)</Badge>
        </div>

        <div className="grid sm:grid-cols-2 gap-3">
          {/* Cas flux adaptatif : reponses non vide */}
          {r.reponses && r.reponses.length > 0 ? (
            r.reponses.map((rep, i) => (
              <QuestionCard
                key={i}
                numero={i + 1}
                question={rep.question}
                reponse={rep.reponse}
                gravite={(rep.gravite as Gravite) ?? graviteForTag(r.tags[i] ?? '', r.nps)}
              />
            ))
          ) : (
            /* Cas flux legacy : afficher les tags comme dimensions évaluées */
            r.tags.map((tag, i) => (
              <QuestionCard
                key={tag + i}
                numero={i + 1}
                question={`Dimension évaluée : ${getTagInfo(tag).label}`}
                reponse={`${getTagInfo(tag).emoji} ${getTagInfo(tag).label}`}
                gravite={graviteForTag(tag, r.nps)}
              />
            ))
          )}
        </div>

        {/* Commentaire libre */}
        {r.commentaire && (
          <Card className="rounded-2xl">
            <CardContent className="p-4 flex gap-3">
              <div className="w-9 h-9 rounded-lg bg-muted flex items-center justify-center shrink-0">
                <MessageSquareText className="w-4 h-4" />
              </div>
              <div className="space-y-1 min-w-0">
                <div className="text-xs font-semibold uppercase tracking-wide text-muted-foreground">💬 Commentaire libre</div>
                <p className="text-sm whitespace-pre-wrap">{r.commentaire}</p>
              </div>
            </CardContent>
          </Card>
        )}

        {/* Photo jointe */}
        {r.photoUrl && (
          <Card className="rounded-2xl">
            <CardContent className="p-4 flex gap-3">
              <div className="w-9 h-9 rounded-lg bg-muted flex items-center justify-center shrink-0">
                <Camera className="w-4 h-4" />
              </div>
              <div className="space-y-2 min-w-0 flex-1">
                <div className="text-xs font-semibold uppercase tracking-wide text-muted-foreground">📸 Photo jointe</div>
                <button onClick={() => setShowPhotoDialog(true)} className="block group">
                  <img
                    src={r.photoUrl}
                    alt="Photo du retour"
                    className="max-h-40 rounded-lg border hover:opacity-90 transition-opacity"
                  />
                  <span className="text-xs text-muted-foreground group-hover:text-foreground">Cliquer pour zoomer</span>
                </button>
              </div>
            </CardContent>
          </Card>
        )}
      </section>

      {/* ============================================================ */}
      {/* SECTION 2 — Récompense client (si présente)                  */}
      {/* ============================================================ */}
      {recompense?.active && r.recompenseAttribuee && (
        <section>
          <Card className="rounded-2xl border-amber-200 bg-amber-50 dark:bg-amber-950/30 dark:border-amber-900">
            <CardContent className="p-4 sm:p-5 space-y-3">
              <div className="flex items-center gap-2">
                <div className="w-9 h-9 rounded-lg bg-amber-200 dark:bg-amber-900 flex items-center justify-center">
                  <Gift className="w-4 h-4 text-amber-700 dark:text-amber-300" />
                </div>
                <div>
                  <div className="text-xs font-semibold uppercase tracking-wide text-amber-700 dark:text-amber-300">🎁 Récompense client</div>
                  <div className="font-semibold">{recompenseTypeLabel(recompense.type)}</div>
                </div>
              </div>
              {recompense.texte && (
                <div className="text-sm">
                  <span className="text-muted-foreground">Texte affiché :</span>{' '}
                  <span className="italic">« {recompense.texte} »</span>
                </div>
              )}
              {recompense.codePromo && (
                <div className="text-sm">
                  <span className="text-muted-foreground">Code promo :</span>{' '}
                  <code className="px-2 py-0.5 rounded bg-amber-100 dark:bg-amber-900 font-mono font-semibold">{recompense.codePromo}</code>
                </div>
              )}
              <div className="text-sm">
                <span className="text-muted-foreground">Statut :</span>{' '}
                {r.recompenseUtilisee && r.dateRecompenseUtilisee ? (
                  <span className="inline-flex items-center gap-1 text-green-700 dark:text-green-400 font-medium">
                    <CheckCircle2 className="w-4 h-4" />
                    Utilisé le {formatDateTimeFr(r.dateRecompenseUtilisee)}
                  </span>
                ) : (
                  <span className="inline-flex items-center gap-1 text-amber-700 dark:text-amber-400 font-medium">
                    <Clock className="w-4 h-4" /> En attente d’utilisation
                  </span>
                )}
              </div>
              {/* Compte à rebours de validité de la récompense */}
              {!r.recompenseUtilisee && (
                <RecompenseCountdown dateAttribution={r.createdAt} />
              )}
            </CardContent>
          </Card>
        </section>
      )}

      {/* ============================================================ */}
      {/* SECTION 3 — Recommandation du Coach IA                       */}
      {/* ============================================================ */}
      <section>
        <CoachCard
          reco={reco}
          loading={recommandationLoadingId === r.id}
          onApply={appliquerRecommandationsIA}
          urgence={urgence}
        />
      </section>

      {/* ============================================================ */}
      {/* SECTION 4 — Appréciation du gérant                           */}
      {/* ============================================================ */}
      <section id="section-action" className="scroll-mt-40">
        <Card className="rounded-2xl">
          <CardHeader className="pb-3">
            <div className="flex items-center gap-2">
              <div className="w-9 h-9 rounded-lg bg-primary/10 flex items-center justify-center">
                <PenLine className="w-4 h-4 text-primary" />
              </div>
              <div>
                <CardTitle className="text-base">Appréciation du gérant</CardTitle>
                <p className="text-xs text-muted-foreground">Action managériale prise sur ce retour.</p>
              </div>
            </div>
          </CardHeader>
          <CardContent className="space-y-4">
            {/* Tags d'action prédéfinis */}
            <div className="space-y-2">
              <Label className="text-xs uppercase tracking-wide text-muted-foreground">Actions prises (multi-sélection)</Label>
              <div className="flex flex-wrap gap-2">
                {ACTION_TAGS.map((t) => {
                  const selected = actionTags.includes(t.id)
                  return (
                    <button
                      key={t.id}
                      type="button"
                      onClick={() => {
                        setActionTags((prev) =>
                          selected ? prev.filter((x) => x !== t.id) : [...prev, t.id]
                        )
                      }}
                      className={cn(
                        'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm border transition-colors',
                        selected
                          ? 'bg-primary text-primary-foreground border-primary'
                          : 'bg-card hover:bg-muted border-border'
                      )}
                    >
                      <span>{selected ? '✅' : '⬜'}</span>
                      <span>{t.emoji}</span>
                      {t.label}
                    </button>
                  )
                })}
              </div>
            </div>

            {/* Commentaire libre */}
            <div className="space-y-2">
              <Label htmlFor="action-commentaire" className="text-xs uppercase tracking-wide text-muted-foreground">
                Commentaire libre
              </Label>
              <Textarea
                id="action-commentaire"
                value={actionCommentaire}
                onChange={(e) => setActionCommentaire(e.target.value)}
                rows={4}
                placeholder="Décrivez l’action menée (briefing, check-list mise en place, etc.)"
              />
            </div>

            {/* Workflow unifié : statut */}
            <div className="space-y-2">
              <Label className="text-xs uppercase tracking-wide text-muted-foreground">Statut du retour</Label>
              <div className="flex flex-wrap gap-2">
                {(['NOUVEAU', 'EN_COURS', 'RESOLU'] as StatutRetour[]).map((s) => {
                  const active = actionStatut === s
                  const labels: Record<StatutRetour, string> = {
                    NOUVEAU: 'Nouveau',
                    EN_COURS: 'En cours',
                    RESOLU: 'Résolu',
                  }
                  return (
                    <button
                      key={s}
                      type="button"
                      onClick={() => allerEtape(s)}
                      className={cn(
                        'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm border transition-colors',
                        active
                          ? 'bg-primary text-primary-foreground border-primary'
                          : 'bg-card hover:bg-muted border-border'
                      )}
                    >
                      {active ? '✅' : '⬜'} {labels[s]}
                    </button>
                  )
                })}
              </div>
            </div>

            <div className="flex justify-end gap-2 pt-1">
              <Button onClick={handleEnregistrerAction} disabled={saving}>
                {saving ? <Loader2 className="w-4 h-4 mr-1.5 animate-spin" /> : <CheckCircle2 className="w-4 h-4 mr-1.5" />}
                Enregistrer l’action
              </Button>
            </div>
          </CardContent>
        </Card>
      </section>

      {/* ============================================================ */}
      {/* DIALOGS (conservés)                                          */}
      {/* ============================================================ */}

      {/* Dialog de réponse au client */}
      <Dialog open={showReponseDialog} onOpenChange={setShowReponseDialog}>
        <DialogContent>
          <DialogHeader>
            <DialogTitle>Répondre au client</DialogTitle>
            <DialogDescription>
              Votre réponse sera envoyée à {r.clientEmail ?? 'l’adresse associée'}.
            </DialogDescription>
          </DialogHeader>
          <div className="space-y-3">
            <Textarea
              value={reponseText}
              onChange={(e) => setReponseText(e.target.value)}
              rows={6}
              placeholder="Bonjour, merci pour votre retour. Nous prenons vos remarques très au sérieux…"
            />
          </div>
          <DialogFooter>
            <Button variant="ghost" onClick={() => setShowReponseDialog(false)}>Annuler</Button>
            <Button onClick={handleEnvoyerReponse} disabled={sendingReponse || !reponseText.trim()}>
              {sendingReponse ? <Loader2 className="w-4 h-4 mr-1.5 animate-spin" /> : <Send className="w-4 h-4 mr-1.5" />}
              Envoyer
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>

      {/* Dialog de suppression (conservé) */}
      <AlertDialog open={showDeleteDialog} onOpenChange={setShowDeleteDialog}>
        <AlertDialogContent>
          <AlertDialogHeader>
            <AlertDialogTitle>Supprimer ce retour ?</AlertDialogTitle>
            <AlertDialogDescription>
              Cette action est irréversible. Le retour sera définitivement supprimé de votre espace.
            </AlertDialogDescription>
          </AlertDialogHeader>
          <AlertDialogFooter>
            <AlertDialogCancel>Annuler</AlertDialogCancel>
            <AlertDialogAction onClick={handleSupprimer} className="bg-destructive text-destructive-foreground hover:bg-destructive/90">
              Supprimer
            </AlertDialogAction>
          </AlertDialogFooter>
        </AlertDialogContent>
      </AlertDialog>

      {/* Dialog de zoom photo (conservé) */}
      <Dialog open={showPhotoDialog} onOpenChange={setShowPhotoDialog}>
        <DialogContent className="max-w-3xl">
          <DialogHeader>
            <DialogTitle>Photo du retour</DialogTitle>
          </DialogHeader>
          {r.photoUrl && (
            <img src={r.photoUrl} alt="Photo du retour (zoom)" className="w-full h-auto rounded-lg" />
          )}
        </DialogContent>
      </Dialog>

      {/* Dialog d'historique employé (conservé) */}
      <Dialog open={showHistoryDialog} onOpenChange={setShowHistoryDialog}>
        <DialogContent className="max-w-lg">
          <DialogHeader>
            <DialogTitle>Historique du client</DialogTitle>
            <DialogDescription>
              {r.clientEmail ?? 'Client anonyme'} — {r.isRecidive ? 'client récidive' : 'premier retour'}
            </DialogDescription>
          </DialogHeader>
          <div className="space-y-2 text-sm">
            <div className="flex justify-between">
              <span className="text-muted-foreground">Premier retour :</span>
              <span>{formatDateFr(r.createdAt)}</span>
            </div>
            <div className="flex justify-between">
              <span className="text-muted-foreground">Récidive :</span>
              <span>{r.isRecidive ? 'Oui' : 'Non'}</span>
            </div>
            <div className="flex justify-between">
              <span className="text-muted-foreground">Récompense attribuée :</span>
              <span>{r.recompenseAttribuee ? 'Oui' : 'Non'}</span>
            </div>
            <div className="flex justify-between">
              <span className="text-muted-foreground">Réponse du gérant :</span>
              <span>{r.reponseGerant ? 'Oui' : 'Non'}</span>
            </div>
            {r.reponseGerant && (
              <div className="pt-2 border-t">
                <div className="text-xs text-muted-foreground mb-1">Dernière réponse :</div>
                <p className="italic text-muted-foreground">« {r.reponseGerant.slice(0, 200)}{r.reponseGerant.length > 200 ? '…' : ''} »</p>
              </div>
            )}
          </div>
        </DialogContent>
      </Dialog>
    </div>
  )
}

// =============================================================================
// Sous-composants du détail
// =============================================================================

function StatutBadgeLight({ statut }: { statut: StatutRetour }) {
  const labels: Record<StatutRetour, string> = {
    NOUVEAU: 'Nouveau',
    EN_COURS: 'En cours',
    RESOLU: 'Résolu',
  }
  return (
    <span className="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-white/20 text-white backdrop-blur">
      {labels[statut]}
    </span>
  )
}

// =============================================================================
// Compte à rebours de la récompense client
// =============================================================================

type CountdownState = 'expire_bientot' | 'bientot' | 'ok' | 'expire'

function getRecompenseState(remainingMs: number): CountdownState {
  if (remainingMs <= 0) return 'expire'
  const hours = remainingMs / 3600_000
  if (hours <= 24) return 'expire_bientot'
  if (hours <= 48) return 'bientot'
  return 'ok'
}

function formatCountdown(remainingMs: number): string {
  if (remainingMs <= 0) return 'Expirée'
  const totalSec = Math.floor(remainingMs / 1000)
  const h = Math.floor(totalSec / 3600)
  const m = Math.floor((totalSec % 3600) / 60)
  const s = totalSec % 60
  const pad = (n: number) => n.toString().padStart(2, '0')
  if (h > 0) return `${h}h ${pad(m)}min ${pad(s)}s`
  if (m > 0) return `${m}min ${pad(s)}s`
  return `${s}s`
}

/**
 * Compte à rebours en temps réel de la validité de la récompense client.
 * La récompense est valide RECOMPENSE_DUREE_VALIDITE_H heures à partir de
 * l'attribution (date de création du retour). Au-delà, elle est expirée.
 */
function RecompenseCountdown({
  dateAttribution,
  compact = false,
}: {
  dateAttribution: string
  compact?: boolean
}) {
  const expiration = useMemo(
    () => dateExpirationRecompense(dateAttribution),
    [dateAttribution]
  )
  const [now, setNow] = useState<number>(() => Date.now())

  useEffect(() => {
    // Tick toutes les secondes pour un compte à rebours fluide
    const id = setInterval(() => setNow(Date.now()), 1000)
    return () => clearInterval(id)
  }, [])

  const remainingMs = expiration.getTime() - now
  const state = getRecompenseState(remainingMs)
  const label = formatCountdown(remainingMs)
  const totalHours = RECOMPENSE_DUREE_VALIDITE_H

  if (compact) {
    const cls =
      state === 'expire'
        ? 'text-red-600 dark:text-red-400'
        : state === 'expire_bientot'
          ? 'text-red-600 dark:text-red-400 font-semibold'
          : state === 'bientot'
            ? 'text-amber-600 dark:text-amber-400'
            : 'text-green-600 dark:text-green-400'
    return (
      <span className={cn('inline-flex items-center gap-1 text-xs', cls)}>
        <Hourglass className="w-3 h-3" />
        {state === 'expire' ? 'Expirée' : `Expire dans ${label}`}
      </span>
    )
  }

  const styles: Record<CountdownState, { box: string; text: string; icon: string; pulse: boolean }> = {
    ok: {
      box: 'bg-green-50 border-green-200 dark:bg-green-950/40 dark:border-green-900',
      text: 'text-green-700 dark:text-green-300',
      icon: 'bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300',
      pulse: false,
    },
    bientot: {
      box: 'bg-amber-50 border-amber-200 dark:bg-amber-950/40 dark:border-amber-900',
      text: 'text-amber-700 dark:text-amber-300',
      icon: 'bg-amber-100 text-amber-700 dark:bg-amber-900 dark:text-amber-300',
      pulse: false,
    },
    expire_bientot: {
      box: 'bg-red-50 border-red-200 dark:bg-red-950/40 dark:border-red-900',
      text: 'text-red-700 dark:text-red-300',
      icon: 'bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-300',
      pulse: true,
    },
    expire: {
      box: 'bg-muted border-border',
      text: 'text-muted-foreground',
      icon: 'bg-muted text-muted-foreground',
      pulse: false,
    },
  }
  const st = styles[state]

  return (
    <div className={cn('rounded-xl border p-3 flex items-center gap-3', st.box)}>
      <div className={cn('w-10 h-10 rounded-lg flex items-center justify-center shrink-0', st.icon, st.pulse && 'animate-pulse')}>
        {state === 'expire' ? <Clock className="w-5 h-5" /> : <Timer className="w-5 h-5" />}
      </div>
      <div className="min-w-0">
        {state === 'expire' ? (
          <>
            <div className={cn('text-sm font-bold tabular-nums', st.text)}>Récompense expirée</div>
            <div className="text-xs text-muted-foreground">
              Validité de {totalHours}h dépassée · attribuée le {formatDateTimeFr(dateAttribution)}
            </div>
          </>
        ) : (
          <>
            <div className={cn('text-base font-bold tabular-nums tracking-tight', st.text, st.pulse && 'animate-pulse')}>
              Expire dans {label}
            </div>
            <div className="text-xs text-muted-foreground">
              {state === 'expire_bientot' && '⚠ Le client doit utiliser sa récompense rapidement. '}
              Validité {totalHours}h · jusqu’au {formatDateTimeFr(expiration)}
            </div>
          </>
        )}
      </div>
    </div>
  )
}

function QuestionCard({
  numero,
  question,
  reponse,
  gravite,
}: {
  numero: number
  question: string
  reponse: string
  gravite: Gravite
}) {
  return (
    <Card className="rounded-2xl shadow-sm">
      <CardContent className="p-4 space-y-2">
        <div className="flex items-start justify-between gap-2">
          <div className="text-sm font-semibold leading-snug">
            <span className="text-muted-foreground">Q{numero}.</span> {question}
          </div>
          <GraviteBadge gravite={gravite} />
        </div>
        <div className="text-sm">
          <span className="text-xs text-muted-foreground">Réponse :</span>{' '}
          <span className="font-medium">{reponse}</span>
        </div>
        <div className="text-xs text-muted-foreground">
          Gravité : <span className="font-medium">{graviteEmoji(gravite)} {gravite}</span>
        </div>
      </CardContent>
    </Card>
  )
}

function recompenseTypeLabel(type: string | null | undefined): string {
  if (!type) return 'Récompense'
  const map: Record<string, string> = {
    cafe_gratuit: 'Café gratuit',
    dessert: 'Dessert offert',
    reduction: 'Réduction',
    boisson: 'Boisson offerte',
  }
  return map[type] ?? type
}

function CoachCard({
  reco,
  loading,
  onApply,
  urgence,
}: {
  reco?: Recommandation
  loading: boolean
  onApply: () => void
  urgence: Urgence
}) {
  // Fond dégradé selon l'urgence
  const gradient =
    urgence === 'URGENT' || urgence === 'A_TRAITER'
      ? 'linear-gradient(135deg, #720032 0%, #b45309 100%)'
      : urgence === 'MITIGE'
        ? 'linear-gradient(135deg, #f59e0b 0%, #ea580c 100%)'
        : 'linear-gradient(135deg, #0da14b 0%, #0a8f3f 100%)'

  const niveauBadge =
    reco?.niveau === 'CRITIQUE'
      ? 'bg-red-600 text-white'
      : reco?.niveau === 'MITIGÉ'
        ? 'bg-amber-500 text-white'
        : 'bg-green-600 text-white'

  return (
    <div
      className="rounded-2xl shadow-lg overflow-hidden text-white"
      style={{ background: gradient }}
    >
      <div className="p-4 sm:p-5 space-y-4">
        {/* Header */}
        <div className="flex items-center justify-between gap-3">
          <div className="flex items-center gap-2">
            <div className="w-9 h-9 rounded-lg bg-white/20 flex items-center justify-center">
              <Brain className="w-5 h-5" />
            </div>
            <div>
              <div className="text-xs font-semibold uppercase tracking-wider text-white/80">Coach IA</div>
              <div className="font-semibold">Recommandation</div>
            </div>
          </div>
          {reco && (
            <span className={cn('inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold uppercase', niveauBadge)}>
              {reco.niveau}
            </span>
          )}
        </div>

        {loading && !reco ? (
          <div className="flex items-center gap-2 text-white/90 text-sm py-6 justify-center">
            <Loader2 className="w-4 h-4 animate-spin" />
            Le coach IA analyse ce retour…
          </div>
        ) : reco ? (
          <>
            {/* Diagnostic */}
            <div className="space-y-1.5">
              <div className="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-white/80">
                <Lightbulb className="w-3.5 h-3.5" />
                Diagnostic
              </div>
              <p className="text-sm leading-relaxed text-white/95">{reco.diagnostic}</p>
            </div>

            {/* Actions prioritaires */}
            <div className="space-y-1.5">
              <div className="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-white/80">
                <Sparkles className="w-3.5 h-3.5" />
                Actions prioritaires
              </div>
              <ol className="space-y-1.5">
                {reco.actions.map((a, i) => (
                  <li key={i} className="flex gap-2 text-sm">
                    <span className="font-bold text-white/70">{i + 1}.</span>
                    <span className="text-white/95">{a}</span>
                  </li>
                ))}
              </ol>
            </div>

            {/* Impact */}
            <div className="flex items-center gap-2 text-sm bg-white/10 rounded-lg px-3 py-2">
              <TrendingUp className="w-4 h-4 shrink-0" />
              <span className="text-white/90">Impact prévu : <strong className="font-semibold">{reco.impact}</strong></span>
            </div>

            {/* Bouton Appliquer */}
            <div className="flex justify-end pt-1">
              <Button
                size="sm"
                variant="secondary"
                onClick={onApply}
                className="bg-white text-foreground hover:bg-white/90"
              >
                <Sparkles className="w-4 h-4 mr-1.5" />
                Appliquer ces recommandations →
              </Button>
            </div>
          </>
        ) : (
          <p className="text-sm text-white/90">Aucune recommandation disponible pour ce retour.</p>
        )}
      </div>
    </div>
  )
}
