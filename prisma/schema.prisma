generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  passwordHash      String
  role              String         @default("PRO")
  suspendu          Boolean        @default(false)
  derniereConnexion DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  notifications     Notification[]
  pro               Pro?
  sessions          Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Pro {
  id                String      @id @default(cuid())
  userId            String      @unique
  nomEtablissement  String
  typeEtablissement String      @default("restaurant")
  adresse           String      @default("")
  ville             String      @default("")
  whatsapp          String?
  email             String      @default("")
  logoUrl           String?
  plan              String      @default("STARTER")
  frequenceRapport  String      @default("quotidien")
  recompense        String?
  recompenseActive  Boolean     @default(false)
  recompenseType    String      @default("cafe")
  recompenseCode    String      @default("")
  recompenseLimite  String?
  messageWhatsapp   String?
  onboardingDone    Boolean     @default(false)
  suspendu          Boolean     @default(false)
  smsAlertes        Boolean     @default(true)
  abonnementDebut   DateTime?
  abonnementFin     DateTime?
  proId             String?
  googlePlaceId     String?
  googleReviewUrl   String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  alertes           Alerte[]
  commandes         Commande[]
  employes          Employe[]
  parent            Pro?        @relation("ProChildren", fields: [proId], references: [id])
  enfants           Pro[]       @relation("ProChildren")
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rapportsIA        RapportIA[]
  retours           Retour[]
  zones             Zone[]
}

model Zone {
  id           String   @id @default(cuid())
  proId        String
  nom          String
  description  String?
  qrToken      String   @unique @default(cuid())
  tagsNegatifs String   @default("[]")
  tagsPositifs String   @default("[]")
  createdAt    DateTime @default(now())
  retours      Retour[]
  pro          Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)

  @@index([proId])
}

model Employe {
  id        String   @id @default(cuid())
  proId     String
  nom       String
  poste     String?
  zoneIds   String   @default("[]")
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  pro       Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)
  retours   Retour[]
}

model Retour {
  id                 String   @id @default(cuid())
  proId              String
  zoneId             String
  employeId          String?
  note               Int
  tags               String   @default("[]")
  commentaire        String?
  personnelMentionne String?
  emailClient        String?
  nps                Int?
  photoUrl           String?
  canalChoisi        String?
  ipCity             String?
  recompenseUtilisee Boolean  @default(false)
  statut             String   @default("NEW")
  historique         String   @default("[]")
  lu                 Boolean  @default(false)
  reponsePro         String?
  actionPrise        String?
  createdAt          DateTime @default(now())
  employe            Employe? @relation(fields: [employeId], references: [id])
  zone               Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  pro                Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)

  @@index([proId, createdAt])
  @@index([zoneId])
}

model RapportIA {
  id              String   @id @default(cuid())
  proId           String
  type            String   @default("quotidien")
  periodeDebut    DateTime
  periodeFin      DateTime
  scoreGlobal     Int      @default(0)
  contenuMarkdown String   @default("")
  priorites       String   @default("[]")
  recommandations String   @default("[]")
  predictions     String   @default("[]")
  source          String   @default("ia")
  envoyeParEmail  Boolean  @default(false)
  envoyeParSMS    Boolean  @default(false)
  createdAt       DateTime @default(now())
  pro             Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)

  @@index([proId, createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Commande {
  id               String   @id @default(cuid())
  proId            String
  zoneId           String?
  typeSupport      String
  quantite         Int
  prixEuros        Int
  adresseLivraison String
  statut           String   @default("A_IMPRIMER")
  pdfUrl           String?
  numeroSuivi      String?
  createdAt        DateTime @default(now())
  pro              Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)

  @@index([proId])
  @@index([statut])
}

model Alerte {
  id        String   @id @default(cuid())
  proId     String
  retourId  String?
  titre     String
  message   String
  canal     String   @default("DASHBOARD")
  type      String   @default("TEMPS_REEL")
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())
  pro       Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)

  @@index([proId, lu])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  titre     String
  message   String
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lu])
  @@index([userId, createdAt])
}
