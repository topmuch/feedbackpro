// ============================================================
// VIP LOUNGE — Tables, Clients VIP, Commandes
// ============================================================

model VipTable {
  id          String   @id @default(cuid())
  tableNumber String   @unique         // "T-01", "T-02", etc.
  zone        String   @default("main") // main, buffet, relaxation, meeting
  seats       Int      @default(4)
  status      String   @default("free") // free, occupied, problem, reserved
  qrToken     String   @unique         // token unique pour le QR code
  clientName  String?                  // nom du client assis (si identifié)
  clientVipLevel String?               // gold, platinum, diamond
  arrivedAt   DateTime?                // heure d'arrivée
  activeRequests Int   @default(0)     // demandes en cours
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  requests    VipTableRequest[]

  @@index([status])
  @@index([zone])
}

model VipClient {
  id          String   @id @default(cuid())
  name        String
  photo       String?
  airline     String?                        // compagnie d'origine / partenaire
  vipLevel    String   @default("gold") // gold, platinum, diamond
  boardingPassId String?
  preferences String   @default("[]")   // JSON: ["préfère rosé", "coin calme"]
  allergies   String   @default("[]")   // JSON: ["arachides", "fruits de mer"]
  // RGPD — consentements explicites (photo + profil) obligatoires
  consentPhoto  Boolean @default(false) // consentement explicite photo
  consentProfil Boolean @default(false) // consentement explicite profil/visites
  // Multi-tenant — lounge propriétaire (null = données de démo partagées)
  ownerUserId String?
  visitCount  Int      @default(0)
  lastVisit   DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  visits        VipVisit[]
  conciergeNotes VipClientNote[]
  guestAlerts   VipGuestAlert[]

  @@index([name])
  @@index([vipLevel])
  @@index([ownerUserId])
  @@index([airline])
}

// VIP — Notes concierge horodatées ("préfère rosé", "allergie arachides")
model VipClientNote {
  id          String   @id @default(cuid())
  vipClientId String
  client      VipClient @relation(fields: [vipClientId], references: [id], onDelete: Cascade)
  auteur      String   @default("Concierge")
  contenu     String
  // type: concierge | allergie | preference | service
  type        String   @default("concierge")
  createdAt   DateTime @default(now())

  @@index([vipClientId, createdAt])
}

// VIP — Historique de visites détaillé (une ligne par venue détectée)
model VipVisit {
  id          String   @id @default(cuid())
  vipClientId String
  client      VipClient @relation(fields: [vipClientId], references: [id], onDelete: Cascade)
  // canal: scan (QR table) | reception (saisie réception) | session (device reconnu)
  canal       String   @default("scan")
  tableNumber String?
  deviceToken String?
  detection   String?                          // détail du critère de match (token, nom+tél, deviceId)
  createdAt   DateTime @default(now())

  @@index([vipClientId, createdAt])
}

// VIP — Alerte Maître d'Hôtel (détection VIP au scan / à la saisie réception)
// Mode discrétion : alerte VISUELLE uniquement (jamais de son fort)
model VipGuestAlert {
  id          String   @id @default(cuid())
  vipClientId String?
  client      VipClient? @relation(fields: [vipClientId], references: [id], onDelete: Cascade)
  clientName  String
  photo       String?
  vipLevel    String   @default("gold")
  airline     String?
  tableNumber String?
  // motif: vip_detected | allergie | retour_client | anniversaire
  motif       String   @default("vip_detected")
  detail      String?
  // statut: nouvelle | prise_en_charge | traitee
  status      String   @default("nouvelle")
  destinataire String  @default("maitre_dhotel")
  takenBy     String?
  takenAt     DateTime?
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
  @@index([vipClientId])
}

// VIP — Configuration du tenant lounge (JSONB-like : pas de migration par option)
// config        → general, alertesVip, buffet, douches, recompenses, notifications,
//                 integrations, modulesEnabled (toggles modules optionnels)
// deniseSettings→ alertes vocales ON/OFF, volume (PLAFONNÉ 30%), ton doux, langues, message bienvenue
model VipTenantConfig {
  id            String   @id @default(cuid())
  loungeKey     String   @unique @default("lounge")
  config        String   @default("{}")
  deniseSettings String  @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// VIP — Journal d'audit des actions staff (traçabilité checklist livraison)
model VipAuditTrail {
  id         String   @id @default(cuid())
  actor      String                       // nom du staff
  actorRole  String?
  action     String                       // VIP_DETECTE | ALERTE_PRISE | PURGE_RGPD | IMPORT_CSV | CLIENT_CREE | CLIENT_MODIFIE | NOTE_AJOUTEE | SETTINGS_MODIFIEES ...
  cible      String?                      // id ou libellé de la cible
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actor])
}

model VipTableRequest {
  id              String   @id @default(cuid())
  // QR_GLOBAL : une demande créée depuis le QR d'entrée (chevalet
  // d'accueil) n'est rattachée à AUCUNE table — le client choisit
  // son emplacement dynamiquement. tableId devient nullable.
  tableId         String?
  table           VipTable? @relation(fields: [tableId], references: [id], onDelete: Cascade)
  // Emplacement libre saisi via la modale Nathalie en mode
  // CLIENT_GLOBAL : "Zone Buffet", "Espace Détente", "Terrasse",
  // "Salles de Réunion" ou "Fauteuil 12". Null pour CLIENT_ZONE
  // (la table porte déjà l'information).
  contextZone     String?
  type            String                       // refreshment, menu, shower, charger, concierge, problem, rating, cleanup
  message         String?
  // Numéro de suivi unique lisible (ex: CMD-2026-0847, SIG-2026-0234)
  trackingNumber  String?  @unique
  // Métadonnées riches au format JSON :
  //   problem    → { tags: ["bruit","proprete"], description, photoUrl }
  //   refreshment→ { items: [{name, qty, category}] }
  //   concierge  → { requestType, details }
  metadata        String   @default("{}")
  status          String   @default("pending") // pending, in_progress, done
  staffName       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tableId, status])
  @@index([status])
}

// ============================================================
// MODULE 1 — COCKPIT MANAGER + MODULE 2 — COMPTOIR RÉCEPTION
// Staff accounts avec auth Tél+PIN et permissions par rôle
// ============================================================

model StaffAccount {
  id          String   @id @default(cuid())
  name        String
  phone       String   @unique              // numéro de téléphone (pré-enregistré)
  pinHash     String                          // hash SHA256 du PIN 4 chiffres
  role        String   @default("reception") // manager | maitre_dhotel | reception | etage | barman
  avatarUrl   String?
  active      Boolean  @default(true)
  failedAttempts Int   @default(0)
  lockedUntil DateTime?
  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // MOTEUR DE ROUTAGE — compétence 1:1 (zones, types maîtrisés, catégorie,
  // disponibilité, capacité max, préférences Denise)
  competency StaffCompetency?
  routingHistory RoutingHistory[]

  @@index([phone])
  @@index([role])
}

// ============================================================
// MOTEUR DE ROUTAGE INTELLIGENT (Routing Engine)
// Cartographie 4D : Zones × Signalements × Employés × Tâches
// Adaptation SQLite : les listes (TEXT[]/UUID[]/TIME[]/JSONB du cahier
// des charges PostgreSQL) sont sérialisées en chaînes JSON.
// ============================================================

// TABLE 1 — COMPÉTENCES DES EMPLOYÉS
model StaffCompetency {
  id             String       @id @default(cuid())
  staffId        String       @unique
  staff          StaffAccount @relation(fields: [staffId], references: [id], onDelete: Cascade)
  tenantKey      String       @default("vip_lounge") // vip_lounge | airport | restaurant
  zones          String       @default("[]")   // JSON codes de zones canoniques
  signalTypes    String       @default("[]")   // JSON codes de types de signalements maîtrisés
  category       String       @default("serveur") // serveur|barman|nettoyage|maintenance|securite|reception|maitre_dhotel|manager
  // DISPONIBILITÉ
  isOnDuty       Boolean      @default(false)
  shiftStart     String?      // "08:00"
  shiftEnd       String?      // "16:00"
  shiftDays      String       @default("[1,2,3,4,5]") // JSON 0=dim … 6=sam
  // ANTI-SURCHARGE
  maxActiveTasks Int          @default(3)
  // Zone où l'employé se trouve actuellement (bonus scoring +30)
  currentZone    String?
  // DENISE
  deniseEnabled  Boolean      @default(true)
  deniseTone     String       @default("normal") // soft|normal|urgent

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([tenantKey, category])
  @@index([tenantKey, isOnDuty])
}

// TABLE 2 — MATRICE DE ROUTAGE (Le Cerveau)
model RoutingRule {
  id                 String   @id @default(cuid())
  tenantKey          String   @default("vip_lounge")
  zoneCode           String?  // null = toutes zones
  signalType         String?  // null = tous types
  priority           String   @default("medium") // low|medium|high|critical
  // ACTIONS (le "ALORS")
  targetCategory     String   @default("serveur")
  targetStaffIds     String   @default("[]") // JSON ciblage direct optionnel
  fallbackCategory   String?  // si personne dispo : ex 'manager'
  // ESCALADE
  escalationAfterMin Int      @default(10)
  escalationTarget   String   @default("manager") // manager | director
  // DENISE
  deniseAnnounce     Boolean  @default(true)
  deniseTone         String   @default("normal") // soft|normal|urgent
  // PRIORITÉ DE LA RÈGLE (si plusieurs matchent) + spécificité implicite
  rulePriority       Int      @default(1)
  active             Boolean  @default(true)

  history            RoutingHistory[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantKey, active])
}

// TABLE 3 — TÂCHES PROACTIVES (au-delà des signalements)
model ProactiveTask {
  id              String    @id @default(cuid())
  tenantKey       String    @default("vip_lounge")
  title           String              // "Vérification buffet"
  description     String?
  // ASSIGNATION
  targetZone      String?   // code canonique
  targetCategory  String?   // 'serveur', 'nettoyage'…
  targetStaffId   String?   // ou assignation automatique
  // PLANIFICATION
  recurrence      String    @default("interval") // once|daily|weekly|interval
  intervalMinutes Int?
  scheduledTimes  String    @default("[]") // JSON ["08:00","12:00","18:00"]
  // CHECKLIST
  checklistItems  String    @default("[]") // JSON [{item,required}]
  // NOTIFICATION
  notifyVia       String    @default("[]") // JSON ["push","denise"]
  deniseMessage   String?   // "Vérification buffet requise"

  lastRunAt       DateTime?
  nextRunAt       DateTime?
  active          Boolean   @default(true)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantKey, active, nextRunAt])
}

// TABLE 4 — HISTORIQUE DE ROUTAGE (pour IA + compteur de charge)
// open=true tant que la tâche assignée n'est pas clôturée → sert de
// compteur current_active_tasks pour l'anti-surcharge.
model RoutingHistory {
  id                String        @id @default(cuid())
  tenantKey         String        @default("vip_lounge")
  incidentKind      String        @default("airport_report") // airport_report | vip_request | proactive
  incidentId        String?
  incidentLabel     String?       // ex: "Niveau sonore élevé — Espace Détente"
  zoneCode          String?
  signalType        String?
  priority          String        @default("medium") // low|medium|high|critical
  staffId           String?
  staff             StaffAccount? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  staffName         String?
  ruleId            String?
  rule              RoutingRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  matchedConditions String        @default("{}") // JSON {zone,type,rulePriority}
  scoreBreakdown    String        @default("[]") // JSON [{label,points}]
  score             Int           @default(0)
  decisionMs        Int           @default(0)   // temps de décision du moteur
  escalated         Boolean       @default(false)
  open              Boolean       @default(true) // tâche active (charge)
  responseTimeSec   Int?          // création → prise en charge
  resolutionTimeSec Int?          // création → résolution
  outcome           String        @default("assigned") // assigned|accepted|resolved|escalated|failed|timeout

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([tenantKey, createdAt])
  @@index([staffId, open])
  @@index([incidentId])
}

// ============================================================
// MODULE 4 — SMART SHOWER QUEUE
// Réservations FIFO avec ETA dynamique
// ============================================================

model ShowerReservation {
  id          String   @id @default(cuid())
  showerNumber Int                              // D-01, D-02 → showerNumber 1, 2
  tableNumber String?                            // table du client qui réserve
  clientName  String?
  status      String   @default("queued")        // queued | ready | using | done | cancelled
  reservedAt  DateTime @default(now())
  readyAt     DateTime?                          // quand la douche est prête
  usedAt      DateTime?                          // quand le client commence à utiliser
  cleanedAt   DateTime?                          // quand le nettoyage est terminé
  expiresAt   DateTime?                          // libération auto après 10 min si no-show
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([showerNumber, status])
  @@index([status])
}

// ============================================================
// MODULE 5 — UPSELLING & PARTENARIATS
// Offres luxe + produits Duty-Free en livraison
// ============================================================

model UpsellOffer {
  id          String   @id @default(cuid())
  title       String                          // "Massage express 15 min", "Bouteille champagne millésimée"
  description String?
  priceFcfa   Int                             // prix en FCFA
  type        String                          // upsell | dutyfree
  category    String?                         // "spa", "champagne", "fasttrack", "souvenirs"
  emoji       String?                         // 💆 🥂 ✈️ 🎁
  stock       Int      @default(-1)           // -1 = illimité
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, active])
}

model VipOrder {
  id              String   @id @default(cuid())
  tableNumber     String?                     // table du client
  clientName      String?
  items           String   @default("[]")     // JSON: [{ offerId, title, priceFcfa, qty }]
  totalFcfa       Int      @default(0)
  status          String   @default("pending") // pending | paid | preparing | delivered | cancelled
  paymentRef      String?                     // référence paiement Wave/Orange Money
  paymentMethod   String?                     // wave | orange_money | cash
  // Numéro de suivi lisible (ex: CMD-2026-0847) — unique, généré à la création
  trackingNumber  String?  @unique
  deliveredAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([tableNumber])
}

// ============================================================
// MODULE 2 — LOST & FOUND (objets trouvés)
// ============================================================

model LostFoundItem {
  id          String   @id @default(cuid())
  title       String                          // "iPhone 15 noir", "Lunettes Ray-Ban"
  description String?
  category    String   @default("other")      // electronics, clothing, accessories, documents, other
  tableNumber String?                         // table où trouvé
  foundBy     String?                         // nom du staff
  status      String   @default("found")      // found | claimed | returned
  claimedBy   String?                         // nom du client qui a réclamé
  returnedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([category])
}

// ============================================================
// MODULE 6 — PRÊT EXPRESS (objets en prêt gratuit)
// ============================================================

model LoanItem {
  id                String   @id @default(cuid())
  name              String                          // "Adaptateur USB-C", "Casque ANC", "Plaid cachemire"
  category          String                          // charger, adapter, headphone, blanket, mask, press
  emoji             String?
  totalStock        Int      @default(5)
  availableStock    Int      @default(5)
  lowStockThreshold Int      @default(2)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  requests          LoanRequest[]

  @@index([category, active])
}

model LoanRequest {
  id          String   @id @default(cuid())
  itemId      String
  item        LoanItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tableNumber String?
  clientName  String?
  qty         Int      @default(1)
  status      String   @default("pending") // pending | delivered | returned
  requestedAt DateTime @default(now())
  deliveredAt DateTime?
  returnedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([itemId])
}

// ============================================================
// MODULE 7 — DÉBARRASSAGE PROACTIF (turnover basé sur vols)
// ============================================================

model FlightEvent {
  id          String   @id @default(cuid())
  flightNo    String                          // "AF123"
  boardingAt  DateTime?                       // heure d'embarquement
  status      String   @default("scheduled")  // scheduled | boarding | departed | delayed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([flightNo])
  @@index([status])
}

model TurnoverTask {
  id              String   @id @default(cuid())
  flightNo        String
  boardingAt      DateTime?
  zones           String   @default("[]")     // JSON: ["relaxation", "main"]
  assignedStaff   String?
  status          String   @default("pending") // pending | assigned | done | cancelled
  doneAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}

// ============================================================
// MODULE 8 — BRIEFING PRISE DE POSTE
// ============================================================

model ShiftBriefing {
  id          String   @id @default(cuid())
  staffName   String
  staffRole   String
  content     String                          // texte du briefing
  durationSec Int      @default(15)
  listened    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ============================================================
// MODULE 10 — FLASH REWARDS PREMIUM (récompenses luxe)
// ============================================================

model PremiumReward {
  id           String   @id @default(cuid())
  title        String                          // "Coupe champagne", "Upgrade Massage 15 min"
  description  String?
  emoji        String?
  costFcfa     Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt
  grants      RewardGrant[]

  @@index([active])
}

model RewardGrant {
  id              String   @id @default(cuid())
  rewardId        String
  reward          PremiumReward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  tableNumber     String?
  clientName      String?
  staffName       String?                     // qui a offert
  triggeredBy     String   @default("manual")  // manual | vip_unhappy_resolved | incident_fast | long_stay | birthday
  deliveredAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([rewardId])
  @@index([tableNumber])
}

// ============================================================
// MODULE 11 — SESSION NATHALIE (tracking client)
// ============================================================

model ClientSession {
  id            String   @id @default(cuid())
  qrType        String   @default("CLIENT_ZONE") // CLIENT_GLOBAL | CLIENT_ZONE
  contextZone   String?                          // table number or zone
  deviceId      String?
  vipClientId   String?
  startedAt     DateTime @default(now())
  expiresAt     DateTime
  lastActiveAt  DateTime @default(now())
  token         String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([token])
  @@index([deviceId])
}
