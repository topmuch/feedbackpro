generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  passwordHash      String
  role              String         @default("PRO")
  suspendu          Boolean        @default(false)
  derniereConnexion DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  notifications     Notification[]
  pro               Pro?
  sessions          Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Pro {
  id                String         @id @default(cuid())
  userId            String         @unique
  nomEtablissement  String
  typeEtablissement String         @default("restaurant")
  adresse           String         @default("")
  ville             String         @default("")
  whatsapp          String?
  email             String         @default("")
  logoUrl           String?
  plan              String         @default("STARTER")
  frequenceRapport  String         @default("quotidien")
  recompense        String?
  recompenseActive  Boolean        @default(false)
  recompenseType    String         @default("cafe")
  recompenseCode    String         @default("")
  recompenseLimite  String?
  messageWhatsapp   String?
  onboardingDone    Boolean        @default(false)
  // Task 1 — Programme d'onboarding "First Week" (0 = pas commencé,
  // 1-4 = étapes en cours, 5 = terminé). Piloté par la bannière du
  // dashboard Pro qui appelle POST /api/pro/onboarding à chaque étape.
  onboardingStep    Int            @default(0)
  // Task 4 — White-label pour agences : si true, l'agence peut personnaliser
  // le nom, la couleur et le logo affichés sur la page de scan de ses clients.
  whiteLabel        Boolean        @default(false)
  brandName         String?
  brandColor        String?
  brandLogoUrl      String?
  // Task 6 — Webhooks sortants (Slack / Discord) : si une URL est renseignée,
  // un payload est envoyé à chaque nouveau retour (négatif ≤ 2★ ou tous) et
  // quand un rapport IA est disponible.
  webhookSlackUrl   String?
  webhookDiscordUrl String?
  suspendu          Boolean        @default(false)
  smsAlertes        Boolean        @default(true)
  abonnementDebut   DateTime?
  abonnementFin     DateTime?
  proId             String?
  googlePlaceId     String?
  googleReviewUrl   String?
  // Task M1 : lien optionnel vers la fiche secteur (SecteurConfig) — permet
  // à l'onboarding, au Coach IA et aux écrans RGPD de s'adapter dynamiquement
  // au secteur de l'établissement (restaurant, hôtel, hôpital, aéroport…).
  secteurId         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  alertes           Alerte[]
  audits            AuditMatin[]
  commandes         Commande[]
  employes          Employe[]
  parent            Pro?           @relation("ProChildren", fields: [proId], references: [id])
  enfants           Pro[]          @relation("ProChildren")
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rapportsIA        RapportIA[]
  retours           Retour[]
  secteur           SecteurConfig? @relation(fields: [secteurId], references: [id])
  zones             Zone[]

  @@index([secteurId])
}

model Zone {
  id           String   @id @default(cuid())
  proId        String
  nom          String
  description  String?
  qrToken      String   @unique @default(cuid())
  tagsNegatifs String   @default("[]")
  tagsPositifs String   @default("[]")
  createdAt    DateTime @default(now())
  retours      Retour[]
  pro          Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)

  @@index([proId])
}

model Employe {
  id        String   @id @default(cuid())
  proId     String
  nom       String
  poste     String?
  zoneIds   String   @default("[]")
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  pro       Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)
  retours   Retour[]
}

model Retour {
  id                 String   @id @default(cuid())
  proId              String
  zoneId             String
  employeId          String?
  note               Int
  tags               String   @default("[]")
  commentaire        String?
  personnelMentionne String?
  emailClient        String?
  nps                Int?
  photoUrl           String?
  canalChoisi        String?
  ipCity             String?
  recompenseUtilisee Boolean  @default(false)
  // Feature 1 — Rattrapage client : nom saisi par le client sur l'écran
  // "Rattrapage" (après envoi d'un retour négatif ≤ 2★). Optionnel.
  // Permet au manager d'identifier le client sur place pour le rattraper
  // avant son départ, et d'envoyer un email de suivi 24h plus tard.
  nomClientRattrapage String?
  // Feature 1 — Date à laquelle le manager a marqué l'alerte rattrapage
  // comme "prise en charge" (clic sur "Je m'en occupe" dans le toast).
  // Null tant que l'alerte n'a pas été traitée.
  rattrapagePrisEnChargeAt DateTime?
  statut             String   @default("NEW")
  historique         String   @default("[]")
  lu                 Boolean  @default(false)
  reponsePro         String?
  actionPrise        String?
  createdAt          DateTime @default(now())
  employe            Employe? @relation(fields: [employeId], references: [id])
  zone               Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  pro                Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)

  @@index([proId, createdAt])
  @@index([zoneId])
}

model RapportIA {
  id              String   @id @default(cuid())
  proId           String
  type            String   @default("quotidien")
  periodeDebut    DateTime
  periodeFin      DateTime
  scoreGlobal     Int      @default(0)
  contenuMarkdown String   @default("")
  priorites       String   @default("[]")
  recommandations String   @default("[]")
  predictions     String   @default("[]")
  source          String   @default("ia")
  envoyeParEmail  Boolean  @default(false)
  envoyeParSMS    Boolean  @default(false)
  createdAt       DateTime @default(now())
  pro             Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)

  @@index([proId, createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Commande {
  id               String   @id @default(cuid())
  proId            String
  zoneId           String?
  typeSupport      String
  quantite         Int
  prixEuros        Int
  adresseLivraison String
  statut           String   @default("A_IMPRIMER")
  pdfUrl           String?
  numeroSuivi      String?
  createdAt        DateTime @default(now())
  pro              Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)

  @@index([proId])
  @@index([statut])
}

model Alerte {
  id        String   @id @default(cuid())
  proId     String
  retourId  String?
  titre     String
  message   String
  canal     String   @default("DASHBOARD")
  type      String   @default("TEMPS_REEL")
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())
  pro       Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)

  @@index([proId, lu])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  titre     String
  message   String
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lu])
  @@index([userId, createdAt])
}

// ============================================================
// Task M1 — Configuration multisectorielle en base (SecteurConfig)
// ------------------------------------------------------------
// Chaque fiche secteur (Restaurant, Hôtel, Aéroport, Hôpital…) est
// matérialisée en BDD plutôt que dans un fichier statique. Cela
// permet :
//   - à l'onboarding de charger dynamiquement zones et tags par défaut
//     selon le secteur choisi (GET /api/secteurs) ;
//   - au Coach IA d'adapter son ton au secteur (conciergerie pour un
//     hôtel, fluidité du check-in pour un aéroport, accueil patient
//     pour un hôpital…) ;
//   - à la page RGPD d'afficher des règles spécifiques par secteur
//     (photos interdites dans les hôpitaux, zones sensibles en
//     aéroport, etc.).
//
// Toutes les structures complexes sont sérialisées en JSON (le
// schéma SQLite ne gère pas nativement les listes/objets).
// ============================================================
model SecteurConfig {
  id                  String   @id @default(cuid())
  nom                 String   @unique
  // JSON : [{ nom: string, tagsPos: string[], tagsNeg: string[] }]
  zonesDefaut         String
  // JSON : string[] — tags globaux (communs à toutes les zones du secteur)
  tagsGlobaux         String   @default("[]")
  // JSON : [{ id, label, target, unit }] — KPIs spéciaux (ex : « temps d'attente »)
  kpisSpeciaux        String   @default("[]")
  // JSON : string[] — codes langues supportés (["fr","en"] par défaut pour un restaurant FR)
  languesSupportees   String   @default("[]")
  // JSON : { photosInterdites: boolean, zonesSensibles: string[] }
  reglesSecurite      String   @default("{}")
  // JSON : string[] — 4 axes d'audit du macro-secteur (ex : "Accueil &
  // Service", "Rapidité & Flux"…). Injectés depuis la base de vérité
  // sectorielle v2 (5 macro-secteurs × 4 piliers). Pour les secteurs non
  // couverts par la base (Boutique, Salon…), on dépose des piliers
  // génériques afin que l'UI scan-view puisse toujours regrouper les
  // tags par pilier.
  piliers             String   @default("[]")
  // JSON : { positifs: [{id,label,contextes[]}], negatifs: [{id,label,contextes[]}] }
  // Tags employés transversaux (communs à tous les macro-secteurs) avec
  // leurs contextes d'application (TOUS = tous secteurs, sinon liste de
  // macros : "HOTELLERIE", "SANTE"…). Permet au scan-view d'afficher une
  // section "Comportement de l'employé" filtrée par secteur du Pro, et au
  // Coach IA d'interpréter les mentions comportementales dans les retours.
  tagsEmployes        String   @default("{}")
  emoji               String   @default("")
  description         String   @default("")
  // Task 2 — Configuration du questionnaire adaptatif (3 scénarios
  // CRISE/MITIGE/SUCCES) stockée en JSON. Éditable depuis le superadmin
  // (onglet "Configuration secteurs"). Voir src/lib/questionnaire-config.ts
  // pour le type ScenarioConfig[]. Fallback sur le hardcoded QUESTIONNAIRE_CONFIG
  // si vide ou invalide (getQuestionnaireConfigFromDb).
  questionnaireConfig String   @default("{}")
  createdAt           DateTime @default(now())
  pros                Pro[]
}

// ============================================================
// Task Contact — Messagerie publique → superadmin
// ------------------------------------------------------------
// Messages envoyés depuis la page de contact publique (/contact).
// Le superadmin les consulte dans l'onglet « Messages » de son
// dashboard (liste, marquer comme lu, supprimer). Aucune relation
// avec le modèle User/Pro : c'est un canal de contact ouvert à tous
// les visiteurs (non connectés).
// ============================================================
model Message {
  id        String   @id @default(cuid())
  nom       String
  email     String
  sujet     String
  message   String
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([lu, createdAt])
}

// ============================================================
// Task Modules — Système de modules activables
// ------------------------------------------------------------
// Chaque module est une fonctionnalité optionnelle qui peut être
// activée/désactivée depuis le superadmin (onglet « Modules »).
// La config spécifique (tauxGain, phone, etc.) est stockée en JSON
// dans le champ `config`. Côté serveur, src/lib/modules.ts expose
// getModuleActif(key) et getModulesActifs() avec un cache mémoire
// court (TTL 30 s) pour éviter de hit la BDD à chaque requête.
//
// Modules gérés (cf. prisma/seed-modules.ts) :
//   - alertes_temps_reel     (activé par défaut) — SMS/Notification si note ≤ 2
//   - voice_to_text          — bouton micro sur la page de scan
//   - abonnement_multi_sites — plan FRANCHISE (199/399/799 €)
//   - loterie                — ticket à gratter digital après l'avis
//   - smart_qr               — questions adaptées selon l'heure du scan
//   - double_shield          (activé par défaut) — redirection avis Google / privé
//   - webhooks_sortants      (activé par défaut) — Slack/Discord
// ============================================================
model Module {
  id          String   @id @default(cuid())
  key         String   @unique
  nom         String
  description String
  actif       Boolean  @default(false)
  config      String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// Task Module 4 — Loterie instantanée (Scratch & Win)
// ------------------------------------------------------------
// Quand un client valide son avis et que le module loterie est
// actif, un ticket à gratter digital est présenté. Si le client
// gagne (probabilité = module.config.tauxGain, défaut 30 %), un
// code promo est dévoilé et un enregistrement GagnantLoterie est
// créé pour audit (et éviter qu'un même client gagne plusieurs
// fois en exploitant un QR code).
// ============================================================
model GagnantLoterie {
  id        String   @id @default(cuid())
  proId     String
  retourId  String
  gain      String
  code      String
  createdAt DateTime @default(now())

  @@index([proId, createdAt])
  @@index([retourId])
}

// ============================================================
// Feature 2 — Auto-Audit du Matin (checklist dictée par l'IA)
// ------------------------------------------------------------
// Chaque matin, le manager remplit une checklist générée par le Coach
// IA à partir des problèmes récurrents détectés la veille (tags
// négatifs les plus fréquents, zones problématiques, etc.).
//
//   items     : JSON [{ id, label, urgence, photoRequise, valide, photoUrl?, note? }]
//   photoUrls : JSON string[] (photos additionnelles attachées à l'audit)
//   scoreManager : % d'items validés (calculé serveur à l'enregistrement)
//   notes     : commentaires libres du manager (textarea en bas du formulaire)
//
// La checklist du jour est générée par GET /api/pro/audit-matin via
// le LLM (z-ai-web-dev-sdk, backend) avec un fallback heuristique
// déterministe. L'historique 30 jours est consultable dans l'onglet
// « Audit Matin » du dashboard Pro.
// ============================================================
model AuditMatin {
  id           String   @id @default(cuid())
  proId        String
  pro          Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)
  date         DateTime @default(now())
  items        String   @default("[]") // JSON: [{ id, label, valide, photoUrl?, note? }]
  photoUrls    String   @default("[]") // JSON: string[]
  scoreManager Int      @default(0) // score auto-calculé (% items validés)
  notes        String?  // commentaires libres du manager
  createdAt    DateTime @default(now())

  @@index([proId, date])
}


// ============================================================
// Fonctionnalité Aéroport — PWA de signalement voyageurs
// ------------------------------------------------------------
// Modèles dédiés (isolés du flux FeedbackPro classique) pour la
// Web App de signalement de problèmes en aéroport. Les voyageurs
// scannent un QR code portant un tag URL lisible (ex: tapis_bagages_1),
// qui est résolu en AirportZone. La zone porte ses 4 problématiques
// prédéfinies (boutons rapides). Le signalement est stocké dans
// AirportReport avec génération d'un payload WhatsApp destiné aux
// équipes opérationnelles de l'aéroport.
// ============================================================
model AirportZone {
  id         String   @id @default(cuid())
  // Code métier lisible : "bagages", "sanitaires", "files_attente",
  // "embarquement", "restauration". Sert de clé d'union avec la config
  // statique src/lib/airport-config.ts.
  code       String   @unique
  nom        String
  emoji      String   @default("📍")
  description String?
  // JSON string[] — tags URL acceptés pour cette zone
  // (ex: ["tapis_bagages_1","tapis_bagages_4"] pour la zone "bagages").
  // Plusieurs tags physiques peuvent pointer vers la même zone logique.
  tags       String   @default("[]")
  // JSON string[] — 4 problématiques prédéfinies (boutons rapides)
  problemes String   @default("[]")
  createdAt  DateTime @default(now())
  reports    AirportReport[]
}

model AirportReport {
  id          String   @id @default(cuid())
  zoneId      String
  zone        AirportZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  // --- Feature affectation à un employé (WhatsApp/email/push) ---
  // Identifiant du destinataire de l'affectation (numéro WhatsApp, email ou
  // token push selon la `method`). Renseigné par POST /api/airport/assign.
  assignedTo  String?
  // Tag URL scanné (ex: "tapis_bagages_1") — gardé pour tracer l'emplacement physique précis
  tagScanne   String
  // Problématique sélectionnée par le voyageur (libellé exact du bouton cliqué)
  problemType String
  commentaire String?
  photoUrl    String?
  // --- Feature VLM (analyse auto photo) ---
  // Catégorie auto-détectée par le modèle de vision (ex: "poubelle_pleine",
  // "papier_toilette_epuise", "prise_usb_cassee", "tapis_arrete"…).
  // Null si pas de photo ou analyse en cours/échouée.
  photoCategory String?
  // Équipe à laquelle le signalement a été auto-routé (ex: "nettoyage",
  // "maintenance", "securite", "accueil"). Dérivé de photoCategory + zone.
  routedTeam  String?
  // Analyse brute JSON retournée par le VLM (description, objets détectés,
  // niveau d'urgence estimé). Pour audit et affichage wallboard.
  photoAnalysis String?
  // --- Feature numéro de vol ---
  // Numéro de vol saisi optionnellement par le voyageur (ex: "AF123", "DL6049").
  // Permet le rattachement signalement → vol et l'escalade compagnie.
  flightNumber String?
  // Opt-in WhatsApp du voyageur (numéro international sans +, ex: 33612345678)
  // Null tant que le voyageur n'a pas demandé à être notifié de la résolution.
  whatsappOptin Boolean @default(false)
  whatsappPhone String?
  // Statut opérationnel : "EN_ATTENTE" → "EN_COURS" → "RESOLU"
  statut      String   @default("EN_ATTENTE")
  // Payload WhatsApp généré à la création (texte exact envoyé aux équipes terrain)
  whatsappPayload String?
  // Date de résolution (pour déclencher la notification au voyageur)
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([zoneId, createdAt])
  @@index([statut])
  @@index([routedTeam])
  @@index([flightNumber])
}

// ============================================================
// Task 6 — WhatsApp Ops Bot : liste blanche des numéros ops
// ------------------------------------------------------------
// Seuls les numéros présents dans cette table (avec actif=true)
// peuvent interroger le bot WhatsApp (/api/airport/whatsapp-webhook).
// Un contact ops est rattaché à un rôle métier (ops, manager,
// nettoyage, maintenance, securite) — utilisé pour l'audit et le
// filtrage futur des commandes par équipe.
// ============================================================
model AirportOpsContact {
  id        String   @id @default(cuid())
  // Format international sans + (ex: 33612345678). Unique.
  phone     String   @unique
  // Libellé libre affiché dans les logs d'audit (ex: "Marc - Responsable Ops")
  name      String
  // Rôle métier : ops | manager | nettoyage | maintenance | securite
  role      String   @default("ops")
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ============================================================
// Fonctionnalité Aéroport — Seuils d'alerte + détection pics
// ------------------------------------------------------------
// Le manager configure des seuils par zone (ex: "alerter si >3
// signalements en 30min sur Sanitaires"). Le système détecte les
// franchissements et notifie automatiquement via WhatsApp/email.
// ============================================================
model AirportAlertThreshold {
  id          String   @id @default(cuid())
  // Code zone : "bagages" | "sanitaires" | "files_attente" |
  // "embarquement" | "restauration" | "ALL" (toutes zones)
  zoneCode    String
  // Type de seuil :
  // "SPIKE_15MIN" — pic de signalements en 15 min
  // "SPIKE_30MIN" — pic de signalements en 30 min
  // "SPIKE_1H"    — pic de signalements en 1 heure
  // "PENDING_COUNT" — nombre de signalements EN_ATTENTE cumulés
  // "NO_RESOLUTION_HOURS" — aucune résolution depuis X heures
  type        String
  // Valeur du seuil (ex: 3 pour 3 signalements, 5 pour 5 pending)
  threshold   Int
  active      Boolean  @default(true)
  // Dernière fois que l'alerte a été déclenchée (anti-spam)
  lastTriggeredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([zoneCode, active])
  @@index([type, active])
}

// ============================================================
// Fonctionnalité Aéroport — Bouton "Aide" PWA voyageur
// ------------------------------------------------------------
// Quand un voyageur clique "Demander de l'aide" sur l'écran de
// confirmation, une AirportHelpRequest est créée et notifiée à
// l'agent ops le plus proche via le bot WhatsApp.
// ============================================================
model AirportHelpRequest {
  id          String   @id @default(cuid())
  // Tag URL scanné (localisation précise du voyageur)
  tagScanne   String
  // Code zone résolu (ex: "sanitaires") pour routage
  zoneCode    String?
  // Message optionnel du voyageur (ex: "Besoin d'aide pour mon bagage")
  message     String?
  // Numéro WhatsApp du voyageur (pour que l'agent le contacte)
  travelerPhone String?
  // Lien optionnel vers le signalement qui a déclenché la demande d'aide
  reportId    String?
  // Statut : "EN_ATTENTE" → "PRIS_EN_CHARGE" → "RESOLU"
  statut      String   @default("EN_ATTENTE")
  // Numéro de l'agent ops qui a pris en charge
  assignedTo  String?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  @@index([zoneCode, statut])
  @@index([statut, createdAt])
}

// ============================================================
// Fonctionnalité Aéroport — SLA temps de résolution
// ------------------------------------------------------------
// Objectif de temps de résolution par zone (en minutes). Le
// wallboard affiche le SLA respecté vs dépassé. Permet de prouver
// le ROI vs FeedbackNow (résolution en minutes, pas en heures).
// ============================================================
model AirportSla {
  id            String   @id @default(cuid())
  // Code zone (unique — un SLA par zone)
  zoneCode      String   @unique
  // Objectif de résolution en minutes (ex: 15 pour sanitaires)
  targetMinutes Int
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================================
// Fonctionnalité Aéroport — Planification des quarts (shifts)
// ------------------------------------------------------------
// Définit les shifts ops (matin/après-midi/nuit) avec les numéros
// WhatsApp actifs sur chaque shift. Les alertes sont routées vers
// l'équipe active au moment du déclenchement.
// ============================================================
model AirportShift {
  id          String   @id @default(cuid())
  name        String   // "Matin", "Après-midi", "Nuit"
  // Heures au format "HH:MM" (24h)
  startTime   String   // "06:00"
  endTime     String   // "14:00"
  // Jours de la semaine actifs : JSON [0,1,2,3,4,5,6] (0=dimanche)
  daysOfWeek  String   @default("[0,1,2,3,4,5,6]")
  // Numéros WhatsApp ops actifs sur ce shift : JSON string[]
  opsPhones   String   @default("[]")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// Fonctionnalité Aéroport — Publicités sur l'écran de confirmation
// ------------------------------------------------------------
// Quand un voyageur clique « Quitter » sur l'écran de confirmation
// de la PWA, une publicité full-screen est affichée avant la sortie.
// Le superadmin gère les publicités (création, activation, suppression)
// depuis l'onglet Paramètres du dashboard admin.
//
//   impressions — incrémenté à chaque affichage (GET /api/airport/ads)
//   clicks      — incrémenté quand le voyageur clique sur le CTA
// ============================================================
model AirportAd {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  linkUrl   String?
  ctaText   String   @default("En savoir plus")
  active    Boolean  @default(true)
  clicks    Int      @default(0)
  impressions Int    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// QR Staff Only — Employés aéroport
// ------------------------------------------------------------
// Les employés scannent un QR "Staff Only" pour :
// 1. Prendre en charge un signalement (photo AVANT)
// 2. Marquer résolu (photo APRÈS) → déclenche voix wallboard
// 3. Signaler un problème interne (manque papier, clim en panne)
//    → déclenche voix wallboard
// ============================================================
model AirportStaffScan {
  id          String   @id @default(cuid())
  // Tag du QR staff scanné (ex: "staff_nettoyage_T2", "staff_maintenance")
  staffTag    String
  // Type d'action : "TAKE_CHARGE" | "RESOLVE" | "REPORT_ISSUE"
  action      String
  // ID du signalement lié (pour TAKE_CHARGE et RESOLVE)
  reportId    String?
  // Photo AVANT (pour TAKE_CHARGE) ou APRÈS (pour RESOLVE)
  photoUrl    String?
  // Message de l'employé (pour REPORT_ISSUE : "Manque de papier")
  message     String?
  // Numéro de l'employé qui a scanné (pour le score)
  staffPhone  String?
  staffName   String?
  // Zone détectée depuis le staffTag
  zoneCode    String?
  createdAt   DateTime @default(now())

  @@index([staffTag, createdAt])
  @@index([reportId])
}
