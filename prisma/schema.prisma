generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  passwordHash      String
  role              String         @default("PRO")
  // TENANT-3 — Type d'établissement pour le système multi-tenant :
  //   - airport    : infrastructure aéroport (wallboard, ops room)
  //   - airline    : compagnie aérienne (escale & passagers)
  //   - vip_lounge : salon VIP (luxe & discrétion)
  //   - classic    : commerce classique (restaurant, hôtel…)
  tenantType        String         @default("classic")
  suspendu          Boolean        @default(false)
  derniereConnexion DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  notifications     Notification[]
  pro               Pro?
  sessions          Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Pro {
  id                String         @id @default(cuid())
  userId            String         @unique
  nomEtablissement  String
  typeEtablissement String         @default("restaurant")
  adresse           String         @default("")
  ville             String         @default("")
  whatsapp          String?
  email             String         @default("")
  logoUrl           String?
  plan              String         @default("STARTER")
  frequenceRapport  String         @default("quotidien")
  recompense        String?
  recompenseActive  Boolean        @default(false)
  recompenseType    String         @default("cafe")
  recompenseCode    String         @default("")
  recompenseLimite  String?
  messageWhatsapp   String?
  onboardingDone    Boolean        @default(false)
  // Task 1 — Programme d'onboarding "First Week" (0 = pas commencé,
  // 1-4 = étapes en cours, 5 = terminé). Piloté par la bannière du
  // dashboard Pro qui appelle POST /api/pro/onboarding à chaque étape.
  onboardingStep    Int            @default(0)
  // Task 4 — White-label pour agences : si true, l'agence peut personnaliser
  // le nom, la couleur et le logo affichés sur la page de scan de ses clients.
  whiteLabel        Boolean        @default(false)
  brandName         String?
  brandColor        String?
  brandLogoUrl      String?
  // Task 6 — Webhooks sortants (Slack / Discord) : si une URL est renseignée,
  // un payload est envoyé à chaque nouveau retour (négatif ≤ 2★ ou tous) et
  // quand un rapport IA est disponible.
  webhookSlackUrl   String?
  webhookDiscordUrl String?
  suspendu          Boolean        @default(false)
  smsAlertes        Boolean        @default(true)
  abonnementDebut   DateTime?
  abonnementFin     DateTime?
  proId             String?
  googlePlaceId     String?
  googleReviewUrl   String?
  // Task M1 : lien optionnel vers la fiche secteur (SecteurConfig) — permet
  // à l'onboarding, au Coach IA et aux écrans RGPD de s'adapter dynamiquement
  // au secteur de l'établissement (restaurant, hôtel, hôpital, aéroport…).
  secteurId         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  alertes           Alerte[]
  audits            AuditMatin[]
  commandes         Commande[]
  employes          Employe[]
  parent            Pro?           @relation("ProChildren", fields: [proId], references: [id])
  enfants           Pro[]          @relation("ProChildren")
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rapportsIA        RapportIA[]
  retours           Retour[]
  secteur           SecteurConfig? @relation(fields: [secteurId], references: [id])
  zones             Zone[]

  @@index([secteurId])
}

model Zone {
  id           String   @id @default(cuid())
  proId        String
  nom          String
  description  String?
  qrToken      String   @unique @default(cuid())
  tagsNegatifs String   @default("[]")
  tagsPositifs String   @default("[]")
  createdAt    DateTime @default(now())
  retours      Retour[]
  pro          Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)

  @@index([proId])
}

model Employe {
  id        String   @id @default(cuid())
  proId     String
  nom       String
  poste     String?
  zoneIds   String   @default("[]")
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  pro       Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)
  retours   Retour[]
}

model Retour {
  id                 String   @id @default(cuid())
  proId              String
  zoneId             String
  employeId          String?
  note               Int
  tags               String   @default("[]")
  commentaire        String?
  personnelMentionne String?
  emailClient        String?
  nps                Int?
  photoUrl           String?
  canalChoisi        String?
  ipCity             String?
  recompenseUtilisee Boolean  @default(false)
  // Feature 1 — Rattrapage client : nom saisi par le client sur l'écran
  // "Rattrapage" (après envoi d'un retour négatif ≤ 2★). Optionnel.
  // Permet au manager d'identifier le client sur place pour le rattraper
  // avant son départ, et d'envoyer un email de suivi 24h plus tard.
  nomClientRattrapage String?
  // Feature 1 — Date à laquelle le manager a marqué l'alerte rattrapage
  // comme "prise en charge" (clic sur "Je m'en occupe" dans le toast).
  // Null tant que l'alerte n'a pas été traitée.
  rattrapagePrisEnChargeAt DateTime?
  statut             String   @default("NEW")
  historique         String   @default("[]")
  lu                 Boolean  @default(false)
  reponsePro         String?
  actionPrise        String?
  createdAt          DateTime @default(now())
  employe            Employe? @relation(fields: [employeId], references: [id])
  zone               Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  pro                Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)

  @@index([proId, createdAt])
  @@index([zoneId])
}

model RapportIA {
  id              String   @id @default(cuid())
  proId           String
  type            String   @default("quotidien")
  periodeDebut    DateTime
  periodeFin      DateTime
  scoreGlobal     Int      @default(0)
  contenuMarkdown String   @default("")
  priorites       String   @default("[]")
  recommandations String   @default("[]")
  predictions     String   @default("[]")
  source          String   @default("ia")
  envoyeParEmail  Boolean  @default(false)
  envoyeParSMS    Boolean  @default(false)
  createdAt       DateTime @default(now())
  pro             Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)

  @@index([proId, createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Commande {
  id               String   @id @default(cuid())
  proId            String
  zoneId           String?
  typeSupport      String
  quantite         Int
  prixEuros        Int
  adresseLivraison String
  statut           String   @default("A_IMPRIMER")
  pdfUrl           String?
  numeroSuivi      String?
  createdAt        DateTime @default(now())
  pro              Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)

  @@index([proId])
  @@index([statut])
}

model Alerte {
  id        String   @id @default(cuid())
  proId     String
  retourId  String?
  titre     String
  message   String
  canal     String   @default("DASHBOARD")
  type      String   @default("TEMPS_REEL")
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())
  pro       Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)

  @@index([proId, lu])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  titre     String
  message   String
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lu])
  @@index([userId, createdAt])
}

// ============================================================
// Task M1 — Configuration multisectorielle en base (SecteurConfig)
// ------------------------------------------------------------
// Chaque fiche secteur (Restaurant, Hôtel, Aéroport, Hôpital…) est
// matérialisée en BDD plutôt que dans un fichier statique. Cela
// permet :
//   - à l'onboarding de charger dynamiquement zones et tags par défaut
//     selon le secteur choisi (GET /api/secteurs) ;
//   - au Coach IA d'adapter son ton au secteur (conciergerie pour un
//     hôtel, fluidité du check-in pour un aéroport, accueil patient
//     pour un hôpital…) ;
//   - à la page RGPD d'afficher des règles spécifiques par secteur
//     (photos interdites dans les hôpitaux, zones sensibles en
//     aéroport, etc.).
//
// Toutes les structures complexes sont sérialisées en JSON (le
// schéma SQLite ne gère pas nativement les listes/objets).
// ============================================================
model SecteurConfig {
  id                  String   @id @default(cuid())
  nom                 String   @unique
  // JSON : [{ nom: string, tagsPos: string[], tagsNeg: string[] }]
  zonesDefaut         String
  // JSON : string[] — tags globaux (communs à toutes les zones du secteur)
  tagsGlobaux         String   @default("[]")
  // JSON : [{ id, label, target, unit }] — KPIs spéciaux (ex : « temps d'attente »)
  kpisSpeciaux        String   @default("[]")
  // JSON : string[] — codes langues supportés (["fr","en"] par défaut pour un restaurant FR)
  languesSupportees   String   @default("[]")
  // JSON : { photosInterdites: boolean, zonesSensibles: string[] }
  reglesSecurite      String   @default("{}")
  // JSON : string[] — 4 axes d'audit du macro-secteur (ex : "Accueil &
  // Service", "Rapidité & Flux"…). Injectés depuis la base de vérité
  // sectorielle v2 (5 macro-secteurs × 4 piliers). Pour les secteurs non
  // couverts par la base (Boutique, Salon…), on dépose des piliers
  // génériques afin que l'UI scan-view puisse toujours regrouper les
  // tags par pilier.
  piliers             String   @default("[]")
  // JSON : { positifs: [{id,label,contextes[]}], negatifs: [{id,label,contextes[]}] }
  // Tags employés transversaux (communs à tous les macro-secteurs) avec
  // leurs contextes d'application (TOUS = tous secteurs, sinon liste de
  // macros : "HOTELLERIE", "SANTE"…). Permet au scan-view d'afficher une
  // section "Comportement de l'employé" filtrée par secteur du Pro, et au
  // Coach IA d'interpréter les mentions comportementales dans les retours.
  tagsEmployes        String   @default("{}")
  emoji               String   @default("")
  description         String   @default("")
  // Task 2 — Configuration du questionnaire adaptatif (3 scénarios
  // CRISE/MITIGE/SUCCES) stockée en JSON. Éditable depuis le superadmin
  // (onglet "Configuration secteurs"). Voir src/lib/questionnaire-config.ts
  // pour le type ScenarioConfig[]. Fallback sur le hardcoded QUESTIONNAIRE_CONFIG
  // si vide ou invalide (getQuestionnaireConfigFromDb).
  questionnaireConfig String   @default("{}")
  createdAt           DateTime @default(now())
  pros                Pro[]
}

// ============================================================
// Task Contact — Messagerie publique → superadmin
// ------------------------------------------------------------
// Messages envoyés depuis la page de contact publique (/contact).
// Le superadmin les consulte dans l'onglet « Messages » de son
// dashboard (liste, marquer comme lu, supprimer). Aucune relation
// avec le modèle User/Pro : c'est un canal de contact ouvert à tous
// les visiteurs (non connectés).
// ============================================================
model Message {
  id        String   @id @default(cuid())
  nom       String
  email     String
  sujet     String
  message   String
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([lu, createdAt])
}

// ============================================================
// Task Modules — Système de modules activables
// ------------------------------------------------------------
// Chaque module est une fonctionnalité optionnelle qui peut être
// activée/désactivée depuis le superadmin (onglet « Modules »).
// La config spécifique (tauxGain, phone, etc.) est stockée en JSON
// dans le champ `config`. Côté serveur, src/lib/modules.ts expose
// getModuleActif(key) et getModulesActifs() avec un cache mémoire
// court (TTL 30 s) pour éviter de hit la BDD à chaque requête.
//
// Modules gérés (cf. prisma/seed-modules.ts) :
//   - alertes_temps_reel     (activé par défaut) — SMS/Notification si note ≤ 2
//   - voice_to_text          — bouton micro sur la page de scan
//   - abonnement_multi_sites — plan FRANCHISE (199/399/799 €)
//   - loterie                — ticket à gratter digital après l'avis
//   - smart_qr               — questions adaptées selon l'heure du scan
//   - double_shield          (activé par défaut) — redirection avis Google / privé
//   - webhooks_sortants      (activé par défaut) — Slack/Discord
// ============================================================
model Module {
  id          String   @id @default(cuid())
  key         String   @unique
  nom         String
  description String
  actif       Boolean  @default(false)
  config      String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// Task Module 4 — Loterie instantanée (Scratch & Win)
// ------------------------------------------------------------
// Quand un client valide son avis et que le module loterie est
// actif, un ticket à gratter digital est présenté. Si le client
// gagne (probabilité = module.config.tauxGain, défaut 30 %), un
// code promo est dévoilé et un enregistrement GagnantLoterie est
// créé pour audit (et éviter qu'un même client gagne plusieurs
// fois en exploitant un QR code).
// ============================================================
model GagnantLoterie {
  id        String   @id @default(cuid())
  proId     String
  retourId  String
  gain      String
  code      String
  createdAt DateTime @default(now())

  @@index([proId, createdAt])
  @@index([retourId])
}

// ============================================================
// Feature 2 — Auto-Audit du Matin (checklist dictée par l'IA)
// ------------------------------------------------------------
// Chaque matin, le manager remplit une checklist générée par le Coach
// IA à partir des problèmes récurrents détectés la veille (tags
// négatifs les plus fréquents, zones problématiques, etc.).
//
//   items     : JSON [{ id, label, urgence, photoRequise, valide, photoUrl?, note? }]
//   photoUrls : JSON string[] (photos additionnelles attachées à l'audit)
//   scoreManager : % d'items validés (calculé serveur à l'enregistrement)
//   notes     : commentaires libres du manager (textarea en bas du formulaire)
//
// La checklist du jour est générée par GET /api/pro/audit-matin via
// le LLM (z-ai-web-dev-sdk, backend) avec un fallback heuristique
// déterministe. L'historique 30 jours est consultable dans l'onglet
// « Audit Matin » du dashboard Pro.
// ============================================================
model AuditMatin {
  id           String   @id @default(cuid())
  proId        String
  pro          Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)
  date         DateTime @default(now())
  items        String   @default("[]") // JSON: [{ id, label, valide, photoUrl?, note? }]
  photoUrls    String   @default("[]") // JSON: string[]
  scoreManager Int      @default(0) // score auto-calculé (% items validés)
  notes        String?  // commentaires libres du manager
  createdAt    DateTime @default(now())

  @@index([proId, date])
}


// ============================================================
// Fonctionnalité Aéroport — PWA de signalement voyageurs
// ------------------------------------------------------------
// Modèles dédiés (isolés du flux FeedbackPro classique) pour la
// Web App de signalement de problèmes en aéroport. Les voyageurs
// scannent un QR code portant un tag URL lisible (ex: tapis_bagages_1),
// qui est résolu en AirportZone. La zone porte ses 4 problématiques
// prédéfinies (boutons rapides). Le signalement est stocké dans
// AirportReport avec génération d'un payload WhatsApp destiné aux
// équipes opérationnelles de l'aéroport.
// ============================================================
model AirportZone {
  id         String   @id @default(cuid())
  // Code métier lisible : "bagages", "sanitaires", "files_attente",
  // "embarquement", "restauration". Sert de clé d'union avec la config
  // statique src/lib/airport-config.ts.
  code       String   @unique
  nom        String
  emoji      String   @default("📍")
  description String?
  // JSON string[] — tags URL acceptés pour cette zone
  // (ex: ["tapis_bagages_1","tapis_bagages_4"] pour la zone "bagages").
  // Plusieurs tags physiques peuvent pointer vers la même zone logique.
  tags       String   @default("[]")
  // JSON string[] — 4 problématiques prédéfinies (boutons rapides)
  problemes String   @default("[]")
  createdAt  DateTime @default(now())
  reports    AirportReport[]
}

model AirportReport {
  id          String   @id @default(cuid())
  zoneId      String
  zone        AirportZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  // --- Feature affectation à un employé (WhatsApp/email/push) ---
  // Identifiant du destinataire de l'affectation (numéro WhatsApp, email ou
  // token push selon la `method`). Renseigné par POST /api/airport/assign.
  assignedTo  String?
  // Tag URL scanné (ex: "tapis_bagages_1") — gardé pour tracer l'emplacement physique précis
  tagScanne   String
  // Problématique sélectionnée par le voyageur (libellé exact du bouton cliqué)
  problemType String
  commentaire String?
  photoUrl    String?
  // --- Feature VLM (analyse auto photo) ---
  // Catégorie auto-détectée par le modèle de vision (ex: "poubelle_pleine",
  // "papier_toilette_epuise", "prise_usb_cassee", "tapis_arrete"…).
  // Null si pas de photo ou analyse en cours/échouée.
  photoCategory String?
  // Équipe à laquelle le signalement a été auto-routé (ex: "nettoyage",
  // "maintenance", "securite", "accueil"). Dérivé de photoCategory + zone.
  routedTeam  String?
  // Analyse brute JSON retournée par le VLM (description, objets détectés,
  // niveau d'urgence estimé). Pour audit et affichage wallboard.
  photoAnalysis String?
  // --- Feature numéro de vol ---
  // Numéro de vol saisi optionnellement par le voyageur (ex: "AF123", "DL6049").
  // Permet le rattachement signalement → vol et l'escalade compagnie.
  flightNumber String?
  // Opt-in WhatsApp du voyageur (numéro international sans +, ex: 33612345678)
  // Null tant que le voyageur n'a pas demandé à être notifié de la résolution.
  whatsappOptin Boolean @default(false)
  whatsappPhone String?
  // Statut opérationnel : "EN_ATTENTE" → "EN_COURS" → "RESOLU"
  statut      String   @default("EN_ATTENTE")
  // Payload WhatsApp généré à la création (texte exact envoyé aux équipes terrain)
  whatsappPayload String?
  // Date de résolution (pour déclencher la notification au voyageur)
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([zoneId, createdAt])
  @@index([statut])
  @@index([routedTeam])
  @@index([flightNumber])
}

// ============================================================
// Task 6 — WhatsApp Ops Bot : liste blanche des numéros ops
// ------------------------------------------------------------
// Seuls les numéros présents dans cette table (avec actif=true)
// peuvent interroger le bot WhatsApp (/api/airport/whatsapp-webhook).
// Un contact ops est rattaché à un rôle métier (ops, manager,
// nettoyage, maintenance, securite) — utilisé pour l'audit et le
// filtrage futur des commandes par équipe.
// ============================================================
model AirportOpsContact {
  id        String   @id @default(cuid())
  // Format international sans + (ex: 33612345678). Unique.
  phone     String   @unique
  // Libellé libre affiché dans les logs d'audit (ex: "Marc - Responsable Ops")
  name      String
  // Rôle métier : ops | manager | nettoyage | maintenance | securite
  role      String   @default("ops")
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ============================================================
// Fonctionnalité Aéroport — Seuils d'alerte + détection pics
// ------------------------------------------------------------
// Le manager configure des seuils par zone (ex: "alerter si >3
// signalements en 30min sur Sanitaires"). Le système détecte les
// franchissements et notifie automatiquement via WhatsApp/email.
// ============================================================
model AirportAlertThreshold {
  id          String   @id @default(cuid())
  // Code zone : "bagages" | "sanitaires" | "files_attente" |
  // "embarquement" | "restauration" | "ALL" (toutes zones)
  zoneCode    String
  // Type de seuil :
  // "SPIKE_15MIN" — pic de signalements en 15 min
  // "SPIKE_30MIN" — pic de signalements en 30 min
  // "SPIKE_1H"    — pic de signalements en 1 heure
  // "PENDING_COUNT" — nombre de signalements EN_ATTENTE cumulés
  // "NO_RESOLUTION_HOURS" — aucune résolution depuis X heures
  type        String
  // Valeur du seuil (ex: 3 pour 3 signalements, 5 pour 5 pending)
  threshold   Int
  active      Boolean  @default(true)
  // Dernière fois que l'alerte a été déclenchée (anti-spam)
  lastTriggeredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([zoneCode, active])
  @@index([type, active])
}

// ============================================================
// Fonctionnalité Aéroport — Bouton "Aide" PWA voyageur
// ------------------------------------------------------------
// Quand un voyageur clique "Demander de l'aide" sur l'écran de
// confirmation, une AirportHelpRequest est créée et notifiée à
// l'agent ops le plus proche via le bot WhatsApp.
// ============================================================
model AirportHelpRequest {
  id          String   @id @default(cuid())
  // Tag URL scanné (localisation précise du voyageur)
  tagScanne   String
  // Code zone résolu (ex: "sanitaires") pour routage
  zoneCode    String?
  // Message optionnel du voyageur (ex: "Besoin d'aide pour mon bagage")
  message     String?
  // Numéro WhatsApp du voyageur (pour que l'agent le contacte)
  travelerPhone String?
  // Lien optionnel vers le signalement qui a déclenché la demande d'aide
  reportId    String?
  // Statut : "EN_ATTENTE" → "PRIS_EN_CHARGE" → "RESOLU"
  statut      String   @default("EN_ATTENTE")
  // Numéro de l'agent ops qui a pris en charge
  assignedTo  String?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  @@index([zoneCode, statut])
  @@index([statut, createdAt])
}

// ============================================================
// Fonctionnalité Aéroport — SLA temps de résolution
// ------------------------------------------------------------
// Objectif de temps de résolution par zone (en minutes). Le
// wallboard affiche le SLA respecté vs dépassé. Permet de prouver
// le ROI vs FeedbackNow (résolution en minutes, pas en heures).
// ============================================================
model AirportSla {
  id            String   @id @default(cuid())
  // Code zone (unique — un SLA par zone)
  zoneCode      String   @unique
  // Objectif de résolution en minutes (ex: 15 pour sanitaires)
  targetMinutes Int
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================================
// Fonctionnalité Aéroport — Planification des quarts (shifts)
// ------------------------------------------------------------
// Définit les shifts ops (matin/après-midi/nuit) avec les numéros
// WhatsApp actifs sur chaque shift. Les alertes sont routées vers
// l'équipe active au moment du déclenchement.
// ============================================================
model AirportShift {
  id          String   @id @default(cuid())
  name        String   // "Matin", "Après-midi", "Nuit"
  // Heures au format "HH:MM" (24h)
  startTime   String   // "06:00"
  endTime     String   // "14:00"
  // Jours de la semaine actifs : JSON [0,1,2,3,4,5,6] (0=dimanche)
  daysOfWeek  String   @default("[0,1,2,3,4,5,6]")
  // Numéros WhatsApp ops actifs sur ce shift : JSON string[]
  opsPhones   String   @default("[]")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// Fonctionnalité Aéroport — Publicités sur l'écran de confirmation
// ------------------------------------------------------------
// Quand un voyageur clique « Quitter » sur l'écran de confirmation
// de la PWA, une publicité full-screen est affichée avant la sortie.
// Le superadmin gère les publicités (création, activation, suppression)
// depuis l'onglet Paramètres du dashboard admin.
//
//   impressions — incrémenté à chaque affichage (GET /api/airport/ads)
//   clicks      — incrémenté quand le voyageur clique sur le CTA
// ============================================================
model AirportAd {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  linkUrl   String?
  ctaText   String   @default("En savoir plus")
  active    Boolean  @default(true)
  clicks    Int      @default(0)
  impressions Int    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// QR Staff Only — Employés aéroport
// ------------------------------------------------------------
// Les employés scannent un QR "Staff Only" pour :
// 1. Prendre en charge un signalement (photo AVANT)
// 2. Marquer résolu (photo APRÈS) → déclenche voix wallboard
// 3. Signaler un problème interne (manque papier, clim en panne)
//    → déclenche voix wallboard
// ============================================================
model AirportStaffScan {
  id          String   @id @default(cuid())
  // Tag du QR staff scanné (ex: "staff_nettoyage_T2", "staff_maintenance")
  staffTag    String
  // Type d'action : "TAKE_CHARGE" | "RESOLVE" | "REPORT_ISSUE"
  action      String
  // ID du signalement lié (pour TAKE_CHARGE et RESOLVE)
  reportId    String?
  // Photo AVANT (pour TAKE_CHARGE) ou APRÈS (pour RESOLVE)
  photoUrl    String?
  // Message de l'employé (pour REPORT_ISSUE : "Manque de papier")
  message     String?
  // Numéro de l'employé qui a scanné (pour le score)
  staffPhone  String?
  staffName   String?
  // Zone détectée depuis le staffTag
  zoneCode    String?
  createdAt   DateTime @default(now())

  @@index([staffTag, createdAt])
  @@index([reportId])
}

// ============================================================
// AirportPushSubscription — abonnements Web Push (PWA staff)
// ------------------------------------------------------------
// Chaque appareil staff qui active les notifications push enregistre
// ici son endpoint + les clés cryptographiques p256dh/auth retournées
// par le navigateur lors de pushManager.subscribe(). Le serveur
// utilise web-push + la clé VAPID privée pour envoyer des
// notifications "always-on" même quand la PWA est fermée.
//
// staffName : nom saisi par l'employé dans la PWA (clé fp-staff-name)
//   — permet de cibler un employé précis si besoin (ex: notifier
//   uniquement l'agent qui a pris en charge un incident).
// endpoint : URL unique du service push (FCM/APNS/Mozilla). Unique
//   par appareil/navigateur — on l'utilise comme clé d'upsert pour
//   éviter les doublons quand le même employé ré-active les notifs.
// p256dh, auth : clés base64url nécessaires au chiffrement du
//   payload par web-push (ECDH P-256 sur Curve25519).
// ============================================================
model AirportPushSubscription {
  id         String   @id @default(cuid())
  endpoint   String   @unique
  p256dh     String
  auth       String
  staffName  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([staffName])
}

// ============================================================
// Score Agent — Gamification
// ------------------------------------------------------------
// Points attribués aux employés pour chaque résolution rapide.
// < 5min = +20pts, < 10min = +10pts, < 20min = +5pts.
// Classement mensuel pour les bonus.
// ============================================================
model AirportAgentScore {
  id           String   @id @default(cuid())
  staffName    String
  staffPhone   String?
  // Points accumulés
  points       Int      @default(0)
  // Nombre de résolutions
  resolutions  Int      @default(0)
  // Temps moyen de résolution en minutes
  avgMinutes   Int      @default(0)
  // Somme des temps pour calculer la moyenne
  totalMinutes Int      @default(0)
  // Mois de référence (format "2026-11")
  month        String
  // Dernier signalement résolu (pour le calcul)
  lastResolvedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([staffName, month])
  @@index([month, points])
}

// ============================================================
// Black Box — Audit trail immuable
// ------------------------------------------------------------
// Chaque transition de statut d'un AirportReport est enregistrée
// ici. Impossible à effacer, impossible de tricher.
// ============================================================
model AirportAuditTrail {
  id          String   @id @default(cuid())
  reportId    String
  // Action effectuée : "CREATED" | "TAKE_CHARGE" | "RESOLVED" | "ASSIGNED"
  action      String
  // Qui a fait l'action (nom employé, "system", "bot", etc.)
  actor       String
  // Ancien statut
  fromStatut  String?
  // Nouveau statut
  toStatut    String
  // Temps écoulé depuis la création (en minutes)
  elapsedMin  Int?
  // Photo jointe (avant/après)
  photoUrl    String?
  // Note supplémentaire
  note        String?
  createdAt   DateTime @default(now())

  @@index([reportId, createdAt])
  @@index([action, createdAt])
}

// ============================================================
// QR Dynamique Vol — Task D Phase 3
// ------------------------------------------------------------
// Associe un tag de porte (ex: "porte_A12") au vol actuellement
// à quai. Quand un voyageur scanne le QR de la porte, la PWA
// reçoit automatiquement le numéro de vol — pas de saisie manuelle.
// Le manager assigne / libère les portes depuis le dashboard.
// ============================================================
model AirportFlightGate {
  id           String    @id @default(cuid())
  // Tag de la porte (ex: "porte_A12", "porte_B07") — correspond à un
  // tag accepté par la zone "embarquement" dans airport-config.ts
  gateTag      String    @unique
  // Numéro de vol (ex: "AF123", "DL6049")
  flightNumber String
  // Compagnie (ex: "Air France", "Delta") — affichée sur la PWA
  airline      String?
  // Destination (ex: "Paris CDG", "New York JFK")
  destination  String?
  // Heure de départ prévue (format "HH:MM" 24h local)
  scheduledDeparture String?
  // Statut du vol : "BOARDING" | "DEPARTED" | "CANCELLED" | "DELAYED"
  status       String    @default("BOARDING")
  // Actif = true tant que le vol est à quai. Passé à false quand le
  // vol décolle (ou est annulé) — libère la porte pour le prochain vol.
  active       Boolean   @default(true)
  // Notes libres (ex: "Retarde 15min", "Vol groupé AF1180/AF1181")
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([active, status])
  @@index([flightNumber])
}

// ============================================================
// AirportStaffQr — QR codes "Staff Only" persistés (Task Z1)
// ------------------------------------------------------------
// Garde une trace des QR codes générés pour les employés afin
// qu'ils survivent à une fermeture / réouverture du dashboard.
// Le QR lui-même est régénéré à la volée depuis le `tag` via
// /api/airport/staff-qrcode?tag=<tag>&format=png — la ligne DB
// ne stocke que les métadonnées (tag, label, zone rattachée).
// ============================================================
model AirportStaffQr {
  id        String   @id @default(cuid())
  // Tag staff encodé dans l'URL (ex: "staff_nettoyage_T2"). Unique :
  // un même tag ne peut être sauvegardé qu'une fois (upsert côté API).
  tag       String   @unique
  // Libellé lisible affiché dans le dashboard (ex: "Nettoyage T2")
  label     String
  // Code zone optionnel (ex: "sanitaires") pour rattacher le QR staff
  // à une zone aéroport. Permet le filtrage / le badge visuel.
  zoneCode  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneCode])
}

// ============================================================
// Task N1 — Centre de Notifications (SuperAdmin)
// ------------------------------------------------------------
// Centralise la gestion des canaux de notification (Email, WhatsApp,
// SMS Mtarget, Push PWA), les templates par déclencheur et l'historique
// des envois. Piloté depuis l'onglet "Notifications" du dashboard admin.
// ============================================================

model NotificationSetting {
  id        String   @id @default(cuid())
  // Canal : "email" | "whatsapp" | "sms_mtarget" | "push_pwa"
  canal     String   @unique
  // Statut d'activation global
  active    Boolean  @default(false)
  // Configuration JSON (API keys, endpoints, sender IDs, etc.)
  // Ex pour SMS Mtarget : { "endpoint": "https://api.mtarget.sn/v1/sms/send", "login": "...", "password": "...", "senderId": "FBKPRO" }
  // Ex pour WhatsApp : { "provider": "meta", "phoneNumberId": "...", "templateId": "incident_alert_staff" }
  // Ex pour Email : { "provider": "sendgrid", "fromName": "FeedbackPro Alertes", "fromEmail": "alertes@feedbackpro.sn" }
  // Ex pour Push : { "provider": "onesignal", "appId": "..." }
  config    String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationTemplate {
  id          String   @id @default(cuid())
  // Déclencheur : "new_incident" | "assigned" | "resolved" | "escalation_15min" | "escalation_30min"
  trigger     String   @unique
  // Nom affiché : "Nouvel Incident Assigné", "Escalade 15 min", etc.
  label       String
  // Canaux actifs pour ce template : JSON string[] : ["sms_mtarget", "push_pwa", "whatsapp"]
  channels    String   @default("[]")
  // Template du message avec variables : {STAFF_NOM}, {INCIDENT_ID}, {ZONE}, {TYPE}, {LIEN_DIRECT}, {HEURE}, {TEMPS}
  template    String   @default("Incident {TYPE} a {ZONE}. Lien : {LIEN_DIRECT}")
  // Destinataire : "assigned_staff" | "terminal_staff" | "supervisor"
  recipient   String   @default("assigned_staff")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NotificationLog {
  id          String   @id @default(cuid())
  // Template trigger qui a déclenché l'envoi
  trigger     String
  // Canal utilisé
  canal       String
  // Destinataire (numéro/email/staffName)
  recipient   String
  // Statut : "sent" | "failed" | "delivered" | "read"
  status      String   @default("sent")
  // Message envoyé (pour audit)
  message     String?
  // Coût (pour SMS principalement)
  cost        Float?
  // ReportId lié si applicable
  reportId    String?
  createdAt   DateTime @default(now())

  @@index([trigger, createdAt])
  @@index([canal, status])
}

// ============================================================
// Task O1 — Centre Opérationnel (SuperAdmin NOC)
// ------------------------------------------------------------
// Logs d'intégrité des 7 services critiques de la plateforme :
//   db_primary, mtarget_sms, whatsapp_api, smtp_email,
//   push_pwa, denise_tts, service_worker
// Seuls les status "warning" et "critical" sont journalisés (pour
// éviter de saturer la table avec des "ok"). Le centre opérationnel
// (admin-operations-tab) interroge /api/admin/operations/health
// toutes les 10s et /api/admin/operations/alerts toutes les 5s.
// ============================================================

model SystemHealthLog {
  id           String    @id @default(cuid())
  // Service : "db_primary" | "mtarget_sms" | "whatsapp_api" | "smtp_email" | "push_pwa" | "denise_tts" | "service_worker"
  serviceName  String
  // Status : "ok" | "warning" | "critical"
  status       String
  // Latency in ms (if applicable)
  latencyMs    Int?
  // Error message (if any)
  errorMessage String?
  // When detected
  detectedAt   DateTime  @default(now())
  // When resolved (null if still active)
  resolvedAt   DateTime?
  // Whether an alert email was sent
  alertSent    Boolean   @default(false)

  @@index([serviceName, detectedAt])
  @@index([status, detectedAt])
}

// ============================================================
// Task VDE — Voice Decision Engine (Denise's Brain)
// ------------------------------------------------------------
// Denise = la voix de la plateforme. Elle ne parle pas pour
// chaque événement : elle décide si elle doit parler, dans quel
// ton, à quel volume, et si elle doit agréger plusieurs signaux
// proches pour éviter la cacophonie.
//
// 3 modèles :
//   VoiceDecisionRule   — matrice (secteur × eventType) → comportement
//   VoiceAnnouncementLog — historique des annonces (pour audit + dédup)
//   VoiceTimeMode        — mode horaire par secteur (night/service/quiet…)
//
// Pipeline 5 étapes (lib/voice-decision-engine.ts) :
//   1. Fetch rule (sector + eventType)
//   2. Time context (night/service_lunch/dinner → filtres)
//   3. Aggregation (compter dans la fenêtre, désup si seuil atteint)
//   4. Deduplication (dernier 120s même zoneRef + eventType)
//   5. Build message + log + return decision JSON
// ============================================================

model VoiceDecisionRule {
  id                         String   @id @default(cuid())
  // Secteur : "aeroport" | "restaurant"
  sector                     String
  // Type d'événement : "security_sanitary" | "incident_service" | "new_scan" |
  // "product_missing" | "incident_resolved" | "feedback_positive" |
  // "staff_connect" | "plate_error" | "service_slow" | "negative_feedback" |
  // "product_out_of_stock" | "reservation_cancelled" | "rush_hour"
  eventType                  String
  // shouldSpeak : true = Denise parle, false = silence (notification visuelle seule)
  shouldSpeak                Boolean  @default(true)
  // Priorité : "critical" | "important" | "info" | "silent"
  priority                   String   @default("info")
  // Ton : "urgent" | "firm" | "soft" | "calm"
  tone                       String   @default("firm")
  // Ajustement de volume : "+20%" | "0%" | "-10%"
  volumeAdjustment           String   @default("0%")
  // Template TTS avec variables {ZONE}, {TYPE}, {TEMPS}, {TABLE}, {PRODUIT}, {DETAIL}, {STAFF_NOM}
  template                   String
  // Agrégation : fenêtre en secondes (ex: 180 = 3min). 0 = jamais agréger
  aggregationWindowSec       Int      @default(0)
  // Max annonces par fenêtre (ex: 1 = max 1 annonce / 5min par zone)
  maxAnnouncementsPerWindow  Int      @default(1)
  // Actif
  active                     Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@unique([sector, eventType])
  @@index([sector, active])
}

model VoiceAnnouncementLog {
  id          String   @id @default(cuid())
  // Événement qui a déclenché l'annonce
  eventType   String
  sector      String
  // Message prononcé
  message     String
  // Priorité
  priority    String
  // Zone/table concernée (pour déduplication)
  zoneRef     String?
  // ReportId lié si applicable
  reportId    String?
  // Si shouldSpeak=false, message non prononcé (silence)
  spoken      Boolean  @default(true)
  // Raison de la décision (pour audit)
  reason      String?
  createdAt   DateTime @default(now())

  @@index([sector, zoneRef, createdAt])
  @@index([eventType, createdAt])
}

model VoiceTimeMode {
  id          String   @id @default(cuid())
  sector      String   @unique
  // JSON : { "06-10": "opening", "10-14": "service_lunch", "14-18": "quiet", "18-22": "service_dinner", "22-06": "night" }
  // En mode "night" : uniquement security/sanitary. En "service_lunch/dinner" : uniquement critical+important.
  modes       String   @default("{\"06-10\":\"opening\",\"10-14\":\"service_lunch\",\"14-18\":\"quiet\",\"18-22\":\"service_dinner\",\"22-06\":\"night\"}")
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// ============================================================
// ContactMessage — Messages reçus depuis le formulaire contact
// ============================================================
model ContactMessage {
  id          String   @id @default(cuid())
  nom         String
  email       String
  typeEtablissement String?
  volume      String?
  defi        String?
  message     String
  statut      String   @default("NOUVEAU") // NOUVEAU | LU | TRAITE
  createdAt   DateTime @default(now())

  @@index([statut, createdAt])
}

// ============================================================
// RÉGIE PUBLICITAIRE — Task AD1
// ------------------------------------------------------------
// Plateforme AdTech pour la zone aéroport (leaderboard 916x90).
// Triple verrou : isAdEligible sur AirportZoneConfig (DB),
// check backend 403 dans /api/admin/ads/campaigns, frontend
// Select avec zones interdites désactivées + tooltip.
// ============================================================

model Advertiser {
  id             String      @id @default(cuid())
  companyName    String
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  billingAddress String?
  logoUrl        String?
  createdAt      DateTime    @default(now())
  campaigns      Campaign[]
  flashRewardCampaigns FlashRewardCampaign[]
}

model Campaign {
  id               String         @id @default(cuid())
  advertiserId     String
  advertiser       Advertiser     @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  title            String
  imageUrl         String? // 916x90 leaderboard format
  landingUrl       String?
  zoneCode         String // Parking, Dépose, Tapis, Embarq, Arrivée
  priority         Int            @default(1)
  startDate        DateTime
  endDate          DateTime?
  dailyBudgetViews Int? // max impressions per day
  status           String         @default("draft") // draft | active | paused | completed
  priceMonthlyFcfa Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  slots            CampaignSlot[]
  stats            AdStat[]

  @@index([zoneCode, status])
  @@index([advertiserId])
}

model CampaignSlot {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0=Dim, 1=Lun... 6=Sam
  startTime  String // "08:00"
  endTime    String // "10:00"
  zoneCode   String
  createdAt  DateTime @default(now())

  @@index([zoneCode, dayOfWeek])
  @@index([campaignId])
}

model AdStat {
  id             String   @id @default(cuid())
  campaignId     String
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  zoneCode       String
  viewDate       DateTime @default(now())
  viewHour       Int // 0-23
  impressions    Int      @default(0)
  clicks         Int      @default(0)
  uniqueVisitors Int      @default(0)

  @@index([campaignId, viewDate])
  @@index([zoneCode, viewDate])
}

// ============================================================
// Task F3 — Marketplace Intégrations : WebhookEndpoints
// ------------------------------------------------------------
// Endpoints de webhook pour intégrations tierces (Slack, Microsoft
// Teams, Zapier, Make.com, n8n, etc.). Chaque endpoint s'abonne à
// une liste d'événements (new_incident, resolved, escalation,
// prediction_alert). Quand un de ces événements se produit sur la
// plateforme, dispatchWebhook() envoie un HTTP POST au webhook.
//
// events : JSON string[] sérialisé (Prisma SQLite ne supporte pas
//   les listes natives). Déserialisé côté API par JSON.parse.
// active : toggle pour désactiver un endpoint sans le supprimer
//   (utile pour la maintenance ou les quotas atteints).
// ============================================================
model WebhookEndpoint {
  id        String   @id @default(cuid())
  name      String
  url       String
  events    String   @default("[]")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ============================================================
// Task F3 — Body Cam Staff : géolocalisation temps réel
// ------------------------------------------------------------
// Chaque POST /api/airport/staff-location enregistre la position GPS
// d'un employé aéroport (capture au moment de la prise en charge et
// de la résolution d'un incident). GET retourne toutes les positions
// récentes (< 10 min) pour affichage en overlay sur la wallboard map.
//
// staffName : libellé libre saisi par l'employé sur la PWA (clé de
//   regroupement — plusieurs enregistrements par employé au fil du
//   temps, on garde l'historique pour audit).
// lat, lng : coordonnées GPS en degrés décimaux (WGS84).
// createdAt : horodatage serveur — utilisé pour filtrer les
//   positions "actives" (recentes) côté wallboard.
// ============================================================
model AirportStaffLocation {
  id        String   @id @default(cuid())
  staffName String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  @@index([staffName, createdAt])
}

// ============================================================
// Flash Rewards — Cartes à gratter post-signalement
// ------------------------------------------------------------
// Module de récompenses voyageurs : après qu'un passager a signalé
// un incident (et 3s après la voix de Denise), une carte à gratter
// s'affiche. Le voyageur gratte → révèle une récompense (ex: -15%
// au Café Teranga) avec un code unique. L'annonceur paie uniquement
// les codes UTILISÉS (prix par code).
//
// Anti-abus : 1 code par session, 3 codes/jour/IP, incident valide
// requis. Les codes expirent après codeValidityHours.
// ============================================================

model FlashRewardCampaign {
  id                 String   @id @default(cuid())
  advertiserId       String
  advertiser         Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  title              String   // "Un café offert pour tout achat de 2000 FCFA"
  rewardType         String   // percentage | fixed_amount | free_article | gift
  rewardValue        String   // "15" (avec unité implicite selon rewardType)
  description        String   // affichée sur la carte révélée
  imageUrl           String?  // visuel 1200x800 (logo + design attractif)
  eligibleZones      String   @default("[]") // JSON string[] de codes zones
  triggerIncidentTypes String @default("[]") // JSON string[] de problemTypes (vide = tous)
  maxPerDay          Int      @default(50)
  maxTotal           Int      @default(500)
  codeValidityHours  Int      @default(24)
  activeFrom         String   @default("08:00") // HH:MM
  activeTo           String   @default("22:00") // HH:MM
  pricePerCodeFcfa   Int      @default(500)
  status             String   @default("active") // active | paused | expired
  startDate          DateTime @default(now())
  endDate            DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  codes              FlashRewardCode[]
  stats              FlashRewardStat[]

  @@index([advertiserId, status])
  @@index([status, startDate])
}

model FlashRewardCode {
  id          String    @id @default(cuid())
  campaignId  String
  campaign    FlashRewardCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  code        String    @unique // "FBK-7X9M-2026"
  status      String    @default("unused") // unused | scratched | used | expired
  reportId    String?   // FK vers AirportReport (le signalement déclencheur)
  zoneCode    String?
  clientIp    String?
  scratchedAt DateTime?
  usedAt      DateTime?
  expiresAt   DateTime  // maintenant + codeValidityHours à la génération
  createdAt   DateTime  @default(now())

  @@index([campaignId, status])
  @@index([code])
  @@index([reportId])
}

model FlashRewardStat {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    FlashRewardCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  statDate    DateTime @default(now())
  views       Int      @default(0) // carte affichée
  scratches   Int      @default(0) // grattements effectués
  used        Int      @default(0) // codes marqués utilisés
  revenueFcfa Int      @default(0) // used × pricePerCodeFcfa

  @@index([campaignId, statDate])
}

