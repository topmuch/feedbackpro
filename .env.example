# ============================================================
# FeedbackPro - Variables d'environnement (exemple)
# Copier ce fichier vers .env puis adapter les valeurs :
#   cp .env.example .env
# ============================================================

# Base de données (SQLite en local / dev — PostgreSQL en production)
DATABASE_URL=file:/home/z/my-project/db/custom.db
# Exemple production (Supabase / Neon) :
# DATABASE_URL=postgresql://user:password@host:5432/feedbackpro?schema=public

# URL publique de l'application (utilisée pour les liens de scan QR)
NEXT_PUBLIC_APP_URL=http://localhost:3000
